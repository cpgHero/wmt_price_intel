{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": [
      "/apps/worker/**",
      "/agent-prompts/**",
      "/packages/python/**",
      "/config/**",
      "/product-packs/**",
      "/report-blueprints/**",
      "/schemas/**",
      "/pyproject.toml",
      "/uv.lock"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 90
  }
}
