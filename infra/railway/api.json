{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/python/**",
      "/agent-prompts/**",
      "/config/**",
      "/product-packs/**",
      "/report-blueprints/**",
      "/database/**",
      "/schemas/**",
      "/pyproject.toml",
      "/uv.lock"
    ]
  },
  "deploy": {
    "preDeployCommand": "alembic -c database/alembic.ini upgrade head",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 20,
    "drainingSeconds": 30
  }
}
