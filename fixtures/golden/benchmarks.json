{
  "schema_version": "2.0.0",
  "purpose": "Executable golden regression assertions derived from the five human-validated August 2026 studies. Full raw category datasets are intentionally not duplicated in this handoff bundle; attach them separately for full regression runs.",
  "categories": {
    "fresh_shell_eggs": {
      "dataset_id": "egg_aug2026_full_retailer",
      "source_rows": 386889,
      "assertions": [
        {
          "name": "total_strict_matches",
          "source": "eggs/strict_price_summary.csv",
          "source_format": "csv",
          "selector": {
            "type": "aggregate",
            "operation": "sum",
            "field": "matches"
          },
          "expected": 5155,
          "tolerance_abs": 5
        },
        {
          "name": "overall_strict_walmart_lower_rate",
          "source": "eggs/strict_price_summary.csv",
          "source_format": "csv",
          "selector": {
            "type": "ratio_of_sums",
            "numerator_field": "walmart_lower_count",
            "denominator_field": "matches"
          },
          "expected": 0.7468477206595538,
          "tolerance_abs": 0.001
        },
        {
          "name": "aldi_strict_competitor_lower_rate",
          "source": "eggs/strict_price_summary.csv",
          "source_format": "csv",
          "selector": {
            "type": "row_filter",
            "where": {
              "retailer_name": "ALDI"
            },
            "field": "competitor_lower_rate"
          },
          "expected": 0.5525040387722132,
          "tolerance_abs": 0.002
        }
      ]
    },
