{
  "id": "fresh_ground_beef",
  "name": "Fresh Ground Beef",
  "version": "1.0.0",
  "category_family": "fresh_meat",
  "description": "Raw fresh ground beef segmented by lean/fat ratio, package weight, production claims, and premium tier.",
  "scope": {
    "target_terms": [
      "ground beef",
      "beef ground"
    ],
    "include": [
      "raw fresh ground beef with a defensible lean/fat ratio, package weight, and positive observed price"
    ],
    "exclude": [
      "patties and burgers",
      "frozen or prepared beef",
      "canned or freeze-dried beef",
      "plant-based products",
      "mixed meats and organ blends",
      "nonfood search noise"
    ],
    "hard_exclusion_patterns": [
      "patty",
      "patties",
      "burger",
      "burgers",
      "frozen",
      "freeze dried",
      "canned",
      "plant based",
      "beef and pork",
      "liver",
      "heart",
      "seasoned"
    ],
    "availability_policy": "search_presence",
    "require_positive_price": true
  },
  "attributes": [
    {
      "name": "lean_pct",
      "label": "Lean percentage",
      "data_type": "number",
      "role": "matching",
      "required_for_strict": true,
      "unit": "percent",
      "unknown_policy": "reject_strict",
      "extractors": [
        "title_rule",
        "url_rule",
        "retailer_field",
        "manual"
      ],
      "extraction_rules": [
        {
          "type": "number_pattern",
          "sources": [
            "text"
          ],
          "patterns": [
            "\\b(\\d{2,3})\\s+(?:lean\\s+)?\\d{1,2}\\b",
            "\\b(\\d{2,3})\\s+lean\\b"
          ]
        }
      ]
    },
    {
      "name": "fat_pct",
      "label": "Fat percentage",
      "data_type": "number",
      "role": "matching",
      "required_for_strict": true,
      "unit": "percent",
      "unknown_policy": "reject_strict",
      "extractors": [
        "title_rule",
        "url_rule",
        "retailer_field",
        "manual"
      ],
      "extraction_rules": [
        {
          "type": "number_pattern",
          "sources": [
            "text"
          ],
          "patterns": [
            "\\b\\d{2,3}\\s+(?:lean\\s+)?(\\d{1,2})\\b"
          ]
        }
      ]
    },
    {
      "name": "weight_lb",
      "label": "Package weight",
      "data_type": "number",
      "role": "matching",
      "required_for_strict": true,
      "unit": "lb",
      "unknown_policy": "reject_strict",
      "extractors": [
        "title_rule",
        "url_rule",
        "retailer_field",
        "ai_fallback",
        "manual"
      ],
      "extraction_rules": [
        {
          "type": "measurement",
          "sources": [
            "text"
          ],
          "units": {
            "lb": 1,
            "lbs": 1,
            "pound": 1,
            "pounds": 1,
            "oz": 0.0625,
            "ounce": 0.0625,
            "ounces": 0.0625
          }
        }
      ]
    },
    {
      "name": "organic",
      "label": "Organic",
      "data_type": "boolean",
      "role": "matching",
      "required_for_strict": true,
      "unknown_policy": "reject_strict",
      "extractors": [
        "title_rule",
        "url_rule",
        "retailer_field"
      ],
      "extraction_rules": [
        {
          "type": "boolean_terms",
          "true_terms": [
            "organic",
            "usda organic"
          ],
          "default": false
        }
      ]
    },
    {
      "name": "grass_fed",
      "label": "Grass fed",
      "data_type": "boolean",
      "role": "matching",
      "required_for_strict": true,
      "unknown_policy": "reject_strict",
      "extractors": [
        "title_rule",
        "url_rule",
        "retailer_field"
      ],
      "extraction_rules": [
        {
          "type": "boolean_terms",
          "true_terms": [
            "grass fed",
            "grassfed",
            "grass finished"
          ],
          "default": false
        }
      ]
    },
    {
      "name": "premium_tier",
      "label": "Premium tier",
      "data_type": "enum",
      "role": "matching",
      "required_for_strict": true,
      "allowed_values": [
        "standard",
        "angus",
        "wagyu"
      ],
      "unknown_policy": "reject_strict",
      "extractors": [
        "title_rule",
        "url_rule",
        "retailer_field"
      ],
      "extraction_rules": [
        {
          "type": "term_map",
          "values": {
            "wagyu": [
              "wagyu"
            ],
            "angus": [
              "angus"
            ]
          },
          "default": "standard"
        }
      ]
    },
    {
      "name": "package_format",
      "label": "Package format",
      "data_type": "enum",
      "role": "reporting",
      "required_for_strict": false,
      "allowed_values": [
        "standard",
        "roll_or_chub",
        "tray_or_value_pack",
        "multipack"
      ],
      "unknown_policy": "not_applicable",
      "extractors": [
        "title_rule",
        "url_rule"
      ],
      "extraction_rules": [
        {
          "type": "term_map",
          "values": {
            "roll_or_chub": [
              "roll",
              "chub",
              "brick"
            ],
            "tray_or_value_pack": [
              "tray",
              "value pack"
            ],
            "multipack": [
              "pack of",
              "packages"
            ]
          },
          "default": "standard"
        }
      ]
    },
    {
      "name": "brand",
      "label": "Brand",
      "data_type": "string",
      "role": "identity",
      "required_for_strict": false,
      "unknown_policy": "not_applicable",
      "extractors": [
        "retailer_field"
      ],
      "extraction_rules": [
        {
          "type": "field",
          "sources": [
            "brand"
          ]
        }
      ]
    }
  ],
  "normalization": {
    "primary_display_metric": "package_price",
    "secondary_metrics": [
      "price_per_lb"
    ],
    "conversion_rules": [
      {
        "from": "weight_lb",
        "to": "price_per_lb",
        "formula": "price / weight_lb"
      }
    ],
    "package_equivalence_policy": "exact_package_first"
  },
  "matching_profiles": [
    {
      "id": "strict",
      "label": "Strict same-ZIP and exact-package comparison",
      "geography": "exact_zip",
      "dimensions": [
        "lean_pct",
        "fat_pct",
        "weight_lb",
        "organic",
        "grass_fed",
        "premium_tier"
      ],
      "brand_policy": "ignore_brand",
      "unknown_policy": "reject",
      "price_selection": "lowest_positive",
      "comparison_metric": "package_price",
      "availability_policy": "retailer_specific"
    },
    {
      "id": "unit_price",
      "label": "Best available price per pound",
      "geography": "exact_zip",
      "dimensions": [
        "lean_pct",
        "fat_pct",
        "organic",
        "grass_fed",
        "premium_tier"
      ],
      "brand_policy": "ignore_brand",
      "unknown_policy": "reject",
      "price_selection": "lowest_positive",
      "comparison_metric": "price_per_lb",
      "availability_policy": "retailer_specific"
    },
    {
      "id": "aldi_10mi",
      "label": "ALDI-Walmart 10 mile exact-package sensitivity",
      "geography": "radius",
      "radius_miles": 10,
      "dimensions": [
        "lean_pct",
        "fat_pct",
        "weight_lb",
        "organic",
        "grass_fed",
        "premium_tier"
      ],
      "brand_policy": "ignore_brand",
      "unknown_policy": "reject",
      "price_selection": "lowest_positive",
      "comparison_metric": "package_price",
      "availability_policy": "retailer_specific"
    }
  ],
  "qa_rules": {
    "parity_tolerance_dollars": 0.01,
    "min_price": 0.01,
    "suspicious_gap_pct": 60,
    "require_unit_confirmation_when": [
      "variable-weight listing",
      "multipack unit versus total package"
    ],
    "human_review_conditions": [
      "lean/fat ratio unresolved",
      "package weight unresolved",
      "fresh versus frozen ambiguity",
      "physical weight conflicts with labeled unit count"
    ],
    "sensitivity_checks": [
      {
        "id": "aldi_10mi",
        "radius_miles": 10
      }
    ]
  },
