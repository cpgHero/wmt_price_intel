  "reporting": {
    "headline_segments": [
      "weight_oz",
      "organic"
    ],
    "required_caveats": [
      "do not invent per-berry economics without explicit counts",
      "Amazon competitive position reverses by package size"
    ],
    "recommended_charts": [
      "footprint",
      "segment_win_rate",
      "price_per_lb"
    ],
    "alertable_metrics": [
      "1lb_conventional_gap",
      "2lb_conventional_gap",
      "1lb_organic_parity_rate"
    ],
    "report_blueprint": {
      "id": "fresh_strawberries_leadership",
      "version": "1.0.0"
    },
    "narrative_playbook": {
      "leadership_objective": "Explain Walmart's strawberry position by exact package weight, organic status, and competitor, with explicit attention to Amazon package-size reversals and geographic sensitivity.",
      "required_topics": [
        "data_scope",
        "footprint",
        "exact_price",
        "normalized_price",
        "segment_drivers",
        "segment_reversals",
        "geography",
        "fulfillment",
        "actions",
        "caveats"
      ],
      "decision_lenses": [
        {
          "id": "exact_weight",
          "label": "Exact package weight",
          "question": "Where does Walmart win or lose within the same weight, organic status, form, and specialty claim?",
          "metric_selectors": ["comparison.*.package_price.*"]
        },
        {
          "id": "package_reversal",
          "label": "Package-size reversal",
          "question": "Does the winner differ between conventional one-pound and two-pound packages or organic one-pound packages?",
          "metric_selectors": ["comparison.*.package_price.*", "comparison.*.price_per_lb.*"]
        },
        {
          "id": "proximity",
          "label": "Nearby-store validation",
          "question": "Does the configured radius comparison confirm the exact-ZIP ALDI result?",
          "metric_selectors": ["comparison.*.radius.*"]
        }
      ],
      "action_principles": [
        "Protect broad Walmart strengths against ALDI.",
        "Use separate Amazon alerts for one-pound conventional, two-pound conventional, and organic packages.",
        "Preserve exact package weight and organic status in automated matching."
      ],
      "forbidden_claims": [
        "Do not infer per-berry economics without observed berry counts.",
        "Do not blend one-pound and two-pound Amazon results into one price index."
      ],
      "small_sample_threshold": 25
    },
    "insight_ranking": {
      "weights": {
        "breadth": 0.3,
        "magnitude": 0.3,
        "confidence": 0.2,
        "actionability": 0.2
      },
      "minimum_score": 0.3,
      "max_candidates": 8
    },
    "insight_rules": [
      {
        "id": "competitive_pressure",
        "scope": "both",
        "condition": {
          "field": "competitor_lower_rate",
          "operator": "gt",
          "threshold": 0.5
        },
        "title_template": "{competitor} pressure in {segment}",
        "summary_template": "{competitor} is lower more often than {benchmark} for the selected {profile} comparison.",
        "business_impact": "Package size can reverse the price winner, so action should stay segment-specific.",
        "severity": "high",
        "breadth_scale": 500,
        "magnitude_scale": 0.5,
        "confidence_scale": 250,
        "actionability": 0.95,
        "minimum_matches": 25,
        "limitations": [
          "No per-berry economics are inferred without explicit counts."
        ],
        "recommendation": {
          "action_template": "Review {competitor} losses in {segment} without blending package sizes.",
          "owner": "Category Pricing",
          "rationale_template": "The ranked signal combines repeated market breadth with material observed price pressure."
        }
      },
      {
        "id": "benchmark_strength",
        "scope": "both",
        "condition": {
          "field": "benchmark_lower_rate",
          "operator": "gte",
          "threshold": 0.75
        },
        "title_template": "{benchmark} strength in {segment}",
        "summary_template": "{benchmark} is lower across most validated {profile} comparisons in this segment.",
        "business_impact": "Protect the current package-specific value position while monitoring exceptions.",
        "severity": "positive",
        "breadth_scale": 500,
        "magnitude_scale": 0.25,
        "confidence_scale": 250,
        "actionability": 0.65,
        "minimum_matches": 25
      }
    ]
  },
  "regression": {
    "golden_dataset_ids": [
      "strawberries_aug2026_wmt_aldi_amz"
    ],
    "expected_headlines": [
      {
        "metric": "source_rows",
        "value": 297443
      },
      {
        "metric": "aldi_strict_walmart_lower_rate",
        "value": 0.9996
      },
      {
        "metric": "amazon_1lb_competitor_lower_rate",
        "value": 0.694
      },
      {
        "metric": "amazon_2lb_walmart_lower_rate",
        "value": 0.942
      },
      {
        "metric": "amazon_1lb_organic_parity_rate",
        "value": 0.702
      }
    ],
    "tolerances": {
      "rate_abs": 0.002,
      "count_abs": 10
    }
  }
}
