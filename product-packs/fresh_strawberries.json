  "reporting": {
    "headline_segments": [
      "weight_oz",
      "organic"
    ],
    "required_caveats": [
      "do not invent per-berry economics without explicit counts",
      "Amazon competitive position reverses by package size"
    ],
    "recommended_charts": [
      "footprint",
      "segment_win_rate",
      "price_per_lb"
    ],
    "alertable_metrics": [
      "1lb_conventional_gap",
      "2lb_conventional_gap",
      "1lb_organic_parity_rate"
    ]
  },
  "regression": {
