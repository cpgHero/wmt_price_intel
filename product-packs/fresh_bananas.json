{
  "id": "fresh_bananas",
  "name": "Fresh Bananas & Plantains",
  "version": "1.1.0",
  "category_family": "produce",
  "scope": {
    "target_terms": [
      "banana",
      "bananas",
      "plantain",
      "plantains"
    ],
    "include": [
      "fresh edible bananas",
      "fresh plantains"
    ],
    "exclude": [
      "dried/freeze-dried bananas",
      "banana chips",
      "frozen banana products",
      "snacks",
      "powders",
      "banana-flavored products",
      "nonfood/search noise"
    ],
    "hard_exclusion_patterns": [
      "dried banana",
      "freeze dried banana",
      "banana chip",
      "frozen banana",
      "banana snack",
      "banana powder",
      "banana flavor",
      "banana costume",
      "banana toy",
      "banana plant",
      "banana hanger"
    ],
    "availability_policy": "in_stock_only"
  },
  "attributes": [
    {
      "name": "variety",
      "data_type": "enum",
      "role": "matching",
      "required_for_strict": true,
      "allowed_values": [
        "Standard Yellow",
        "Plantain",
        "Green/Cooking",
        "Manzano/Apple",
        "Burro",
        "Red",
        "Mini/Baby"
      ],
      "unknown_policy": "reject_strict",
      "extractors": [
        "title_rule",
        "url_rule",
        "ai_fallback"
      ],
      "extraction_rules": [
        {
          "type": "term_map",
          "values": {
            "Plantain": [
              "plantain",
              "plantains"
            ],
            "Green/Cooking": [
              "green banana",
              "cooking banana",
              "guineos verdes"
            ],
            "Manzano/Apple": [
              "manzano",
              "apple banana"
            ],
            "Burro": [
              "burro"
            ],
            "Red": [
              "red banana"
            ],
            "Mini/Baby": [
              "mini banana",
              "baby banana"
            ]
          },
          "default": "Standard Yellow"
        }
      ]
    },
    {
      "name": "organic",
      "data_type": "boolean",
      "role": "matching",
      "required_for_strict": true,
      "unknown_policy": "reject_strict",
      "extractors": [
        "title_rule",
        "url_rule"
      ],
      "extraction_rules": [
        {
          "type": "boolean_terms",
          "true_terms": [
            "organic",
            "usda organic"
          ],
          "default": false
        }
      ]
    },
    {
      "name": "selling_unit",
      "data_type": "enum",
      "role": "matching",
      "required_for_strict": true,
      "allowed_values": [
        "each",
        "bunch",
        "lb",
        "fixed_weight_package"
      ],
      "unknown_policy": "review",
      "extractors": [
        "retailer_field",
        "title_rule",
        "url_rule",
        "ai_fallback"
      ],
      "extraction_rules": [
        {
          "type": "term_map",
          "sources": [
            "raw.selling_unit",
            "raw.unit",
            "raw.unit_of_measure"
          ],
          "values": {
            "each": [
              "each",
              "ea"
            ],
            "bunch": [
              "bunch"
            ],
            "lb": [
              "lb",
              "pound",
              "per lb"
            ],
            "fixed_weight_package": [
              "fixed weight",
              "package",
              "bag"
            ]
          }
        },
        {
          "type": "term_map",
          "values": {
            "fixed_weight_package": [
              "fixed weight package",
              "fixed weight",
              "package",
              "bag"
            ],
            "bunch": [
              "bunch"
            ],
            "each": [
              "each",
              "ea"
            ],
            "lb": [
              "per lb",
              "pound",
              "lb"
            ]
          }
        }
      ]
    },
    {
      "name": "weight_lb",
      "data_type": "number",
      "role": "normalization",
      "required_for_strict": false,
      "unit": "lb",
      "unknown_policy": "allow_compatible",
      "extractors": [
        "retailer_field",
        "title_rule",
        "url_rule",
        "manual"
      ],
      "extraction_rules": [
        {
          "type": "measurement",
          "units": {
            "lb": 1,
            "lbs": 1,
            "pound": 1,
            "pounds": 1,
            "oz": 0.0625,
            "ounce": 0.0625,
            "ounces": 0.0625,
            "kg": 2.2046226218,
            "g": 0.0022046226218,
            "gram": 0.0022046226218,
            "grams": 0.0022046226218
          }
        }
      ]
    },
    {
      "name": "count_min",
      "data_type": "number",
      "role": "normalization",
      "required_for_strict": false,
      "unit": "each",
      "unknown_policy": "allow_compatible",
      "extractors": [
        "title_rule",
        "url_rule",
        "manual"
      ],
      "extraction_rules": [
        {
          "type": "number_pattern",
          "sources": [
            "raw_text"
          ],
          "patterns": [
            "(\\d+)\\s*(?:-|–|to)\\s*(\\d+)\\s*(?:count|ct)"
          ],
          "group": 1
        },
        {
          "type": "measurement",
          "units": {
            "count": 1,
            "ct": 1,
            "each": 1
          }
        }
      ]
    },
    {
      "name": "count_max",
      "data_type": "number",
      "role": "normalization",
      "required_for_strict": false,
      "unit": "each",
      "unknown_policy": "allow_compatible",
      "extractors": [
        "title_rule",
        "url_rule",
        "manual"
      ],
      "extraction_rules": [
        {
          "type": "number_pattern",
          "sources": [
            "raw_text"
          ],
          "patterns": [
            "(\\d+)\\s*(?:-|–|to)\\s*(\\d+)\\s*(?:count|ct)"
          ],
          "group": 2
        },
        {
          "type": "measurement",
          "units": {
            "count": 1,
            "ct": 1,
            "each": 1
          }
        }
      ]
    },
    {
      "name": "retailer_product_id",
      "data_type": "string",
      "role": "identity",
      "required_for_strict": false,
      "unknown_policy": "not_applicable",
      "extractors": [
        "retailer_field"
      ],
      "extraction_rules": [
        {
          "type": "field",
          "sources": [
            "retailer_product_id"
          ]
        }
      ]
    },
    {
      "name": "brand",
      "data_type": "string",
      "role": "identity",
      "required_for_strict": false,
      "unknown_policy": "not_applicable",
      "extractors": [
        "retailer_field",
        "title_rule"
      ],
      "extraction_rules": [
        {
          "type": "field",
          "sources": [
            "brand"
          ]
        }
      ]
    }
  ],
  "normalization": {
    "primary_display_metric": "selling_unit_price",
    "secondary_metrics": [
      "price_per_each",
      "price_per_lb",
      "midpoint_price_per_each",
      "price_per_each_low",
      "price_per_each_high",
      "range_midpoint_price_per_each"
    ],
    "conversion_rules": [
      {
        "from": "weight_lb",
        "to": "price_per_lb",
        "formula": "price / weight_lb"
      },
      {
        "from": "count_min",
        "to": "midpoint_price_per_each",
        "formula": "price / ((count_min + count_max)/2)"
      },
      {
        "from": "count_min",
        "to": "price_per_each_low",
        "formula": "price / count_max"
      },
      {
        "from": "count_max",
        "to": "price_per_each_high",
        "formula": "price / count_min"
      },
      {
        "from": "count_min",
        "to": "range_midpoint_price_per_each",
        "formula": "price * (count_min + count_max) / (2 * count_min * count_max)"
      }
    ],
    "forbidden_metrics": [
      "estimated_price_per_each_without_count_or_weight_evidence"
    ],
    "package_equivalence_policy": "category_specific"
  },
  "matching_profiles": [
    {
      "id": "strict_each",
      "label": "Strict each-to-each",
      "geography": "exact_zip",
      "dimensions": [
