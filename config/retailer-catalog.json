    {
      "id": "sams_club_us",
      "display_name": "Sam's Club",
      "api_retailer_aliases": [
        "sam's club",
        "sams club",
        "samsclub.com"
      ]
    },
    {
      "id": "shoprite_us",
      "display_name": "ShopRite",
      "api_retailer_aliases": [
        "shoprite",
