{
  "schema_version": "1.0.0",
  "id": "walmart_us",
  "display_name": "Walmart",
  "version": "1.2.1",
  "status": "active",
  "identity": {
    "canonical_retailer_id": "walmart_us",
    "aliases": ["walmart", "walmart.com", "Walmart (US)"]
  },
  "observation_semantics": {
    "price_authority": "search_location_observation",
    "availability_authority": "search_location_observation",
    "location_dimension": "store_zip",
    "physical_store_reporting": true,
    "notes": [
      "Store selection materially affects price and availability.",
      "Store IDs and leading-zero ZIP codes remain strings."
    ]
  },
  "brand_foundation": {
    "id": "cpg_brand_foundation",
    "version": "2.1.0"
  },
  "brand_policy": {
    "resolution_order": [
      "retailer_context",
      "retailer_exact_canonical",
      "retailer_exact_alias",
      "global_exact_canonical",
      "global_exact_alias",
      "unresolved"
    ],
    "strict_private_label_requires": [
      "in_private_label_matching",
      "approved_review",
      "eligible_status",
      "eligible_class",
      "retailer_owned"
    ],
    "eligible_statuses": ["Active", "Transitioning", "Seasonal"],
    "eligible_classes": [
      "private_label_owned",
      "private_label_exclusive",
      "retailer_banner_brand",
      "sub_brand"
    ],
    "unknown_behavior": "queue_candidate_never_auto_approve",
    "fuzzy_behavior": "suggestion_only_within_retailer"
  },
  "enrichment_policy": {
    "identity_scope": "unique_admitted_products",
    "default_contexts_per_product": 1,
    "price_variant_context_policy": "additional_observed_context_on_price_difference",
    "search_fields_are_immutable": true,
    "default_cache_ttl_days": 30
  },
  "seller_policy": {
    "mode": "first_party_only",
    "source": "pdp_seller",
    "allow_when_missing": true,
    "allowed_first_party_sellers": ["Walmart", "Walmart.com"],
    "non_first_party_behavior": "exclude_as_marketplace_noise",
    "notes": [
      "Known marketplace sellers other than Walmart or Walmart.com are excluded before matching and reporting.",
      "Missing PDP seller values remain eligible but are marked seller-unverified."
    ]
  },
  "matching_boundary": {
    "brand_role": "candidate_generation_only",
    "requires_product_pack_compatibility": true
  }
}
