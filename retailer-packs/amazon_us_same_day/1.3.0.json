{
  "schema_version": "1.0.0",
  "id": "amazon_us_same_day",
  "display_name": "Amazon Same Day",
  "version": "1.3.0",
  "status": "active",
  "identity": {
    "canonical_retailer_id": "amazon_us_same_day",
    "aliases": ["amazon", "amazon.com", "Amazon (US)"]
  },
  "observation_semantics": {
    "price_authority": "search_location_observation",
    "availability_authority": "search_location_observation",
    "location_dimension": "zipcode",
    "physical_store_reporting": false,
    "notes": [
      "Use Same Day or Amazon Fresh search context rather than general Amazon results.",
      "ZIP delivery market is the reporting geography exception; do not invent a physical store."
    ]
  },
  "brand_foundation": { "id": "cpg_brand_foundation", "version": "2.0.0" },
  "brand_policy": {
    "resolution_order": [
      "retailer_context",
      "retailer_exact_canonical",
      "retailer_exact_alias",
      "global_exact_canonical",
      "global_exact_alias",
      "unresolved"
    ],
    "strict_private_label_requires": [
      "in_private_label_matching",
      "approved_review",
      "eligible_status",
      "eligible_class",
      "retailer_owned"
    ],
    "eligible_statuses": ["Active", "Transitioning", "Seasonal"],
    "eligible_classes": [
      "private_label_owned",
      "private_label_exclusive",
      "retailer_banner_brand",
      "sub_brand"
    ],
    "unknown_behavior": "queue_candidate_never_auto_approve",
    "fuzzy_behavior": "suggestion_only_within_retailer",
    "verified_private_labels": [
      {
        "brand_name": "Amazon Elements",
        "aliases": ["Amazon Elements"],
        "category_tags": "vitamins;supplements;health_wellness",
        "evidence_notes": "Governed retailer-owned brand lane for exact title/PDP resolution; brand never overrides specification compatibility."
      },
      {
        "brand_name": "Solimo",
        "aliases": ["Amazon Brand - Solimo", "Amazon Brand Solimo"],
        "category_tags": "vitamins;supplements;health_wellness",
        "evidence_notes": "Governed Amazon-owned legacy brand lane retained for exact historical evidence resolution."
      }
    ]
  },
  "enrichment_policy": {
    "identity_scope": "unique_admitted_products",
    "default_contexts_per_product": 1,
    "price_variant_context_policy": "additional_observed_context_on_price_difference",
    "search_fields_are_immutable": true,
    "default_cache_ttl_days": 30
  },
  "seller_policy": {
    "mode": "first_party_only",
    "source": "pdp_seller",
    "allow_when_missing": true,
    "allowed_first_party_sellers": [
      "Amazon.com",
      "Amazon.com Services LLC",
      "AmazonFresh",
      "Amazon Fresh",
      "Whole Foods Market"
    ],
    "non_first_party_behavior": "exclude_as_marketplace_noise",
    "notes": [
      "The allowed list is based on collected Same Day PDP seller evidence and Amazon-owned retail banners.",
      "All other known sellers are excluded as third-party marketplace noise."
    ]
  },
  "matching_boundary": {
    "brand_role": "candidate_generation_only",
    "requires_product_pack_compatibility": true
  }
}
