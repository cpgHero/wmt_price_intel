        "coverage",
        "price_position",
        "segments",
        "proximity",
        "products",
        "assortment_analysis",
        "quality",
        "methodology"
      ],
      "worksheet_definitions": [
        { "name": "Executive Summary", "source": "insights" },
        { "name": "Leadership Narrative", "source": "narratives" },
        { "name": "Metrics", "source": "metrics" },
        { "name": "Retailer Scorecard", "source": "retailer_scorecards" },
        { "name": "Price Comparisons", "source": "comparisons" },
        { "name": "Segment Analysis", "source": "segments" },
        { "name": "Geography", "source": "geographic_sensitivity" },
        { "name": "Data Quality", "source": "data_quality" },
        { "name": "Methodology", "source": "provenance" }
      ]
    },
    {
      "artifact_type": "leadership_email",
      "section_ids": [
        "executive_summary",
        "coverage",
        "price_position",
        "segments",
        "proximity",
        "products",
        "assortment_analysis",
        "recommendations",
        "quality",
        "methodology"
      ]
    },
    {
      "artifact_type": "audit_zip",
      "section_ids": [
        "coverage",
        "price_position",
        "segments",
        "proximity",
        "products",
        "assortment_analysis",
        "quality",
        "methodology"
      ]
    }
  ],
  "narrative_policy": {
    "require_metric_refs": true,
    "require_evidence_refs": true,
    "allow_unreferenced_numbers": false,
    "required_questions": [
      "what_changed",
      "why_it_matters",
      "who_is_affected",
      "what_to_do_next",
      "what_is_the_evidence"
    ]
  }
}
