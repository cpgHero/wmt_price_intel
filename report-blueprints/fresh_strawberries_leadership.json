{
  "schema_version": "1.0.0",
  "id": "fresh_strawberries_leadership",
  "version": "1.1.0",
  "product_pack": { "id": "fresh_strawberries", "version": "1.1.0" },
  "brand_profile": {
    "id": "cpghero_rci",
    "version": "1.0.0",
    "supports_light_mode": true,
    "supports_dark_mode": true
  },
  "sections": [
    {
      "id": "executive_summary",
      "title": "Executive Summary",
      "kind": "executive_summary",
      "required": true,
      "metric_selectors": [
        "comparison.*.lower_rate",
        "comparison.*.median_gap"
      ],
      "evidence_kinds": ["exact_matches", "normalized_matches"],
      "visualization": "ranked_cards",
      "empty_state": "The analysis did not produce sufficient validated comparisons.",
      "narrative_section_id": "executive_summary"
    },
    {
      "id": "kpis",
      "title": "Decision KPIs",
      "kind": "kpi_strip",
      "required": true,
      "metric_selectors": [
        "source.total_rows",
        "coverage.*.qualifying_zips",
        "comparison.*.matches"
      ],
      "evidence_kinds": [
        "source_manifest",
        "classified_offers",
        "exact_matches"
      ],
      "visualization": "kpi_cards",
      "empty_state": "No validated KPI values were produced."
    },
    {
      "id": "coverage",
      "title": "Observed Fresh-Strawberry Footprint",
      "kind": "coverage",
      "required": true,
      "metric_selectors": ["coverage.*"],
      "evidence_kinds": ["classified_offers"],
      "visualization": "bar",
      "empty_state": "No qualifying geographic coverage was observed.",
      "narrative_section_id": "coverage"
    },
    {
      "id": "price_position",
      "title": "Package-Size Price Position",
      "kind": "price_position",
      "required": true,
      "metric_selectors": ["comparison.*.package_price.*"],
      "evidence_kinds": ["exact_matches"],
      "visualization": "table",
      "empty_state": "No exact-package matches were available.",
      "narrative_section_id": "price_position"
    },
    {
      "id": "segments",
      "title": "Package and Organic Segments",
      "kind": "segment_analysis",
      "required": true,
      "metric_selectors": ["comparison.*"],
      "evidence_kinds": ["exact_matches", "normalized_matches"],
      "visualization": "table",
      "empty_state": "No defensible package segments were available.",
      "narrative_section_id": "segments"
    },
    {
      "id": "proximity",
      "title": "10-Mile Store-Proximity Sensitivity",
      "kind": "geographic_sensitivity",
      "required": true,
      "metric_selectors": ["comparison.*.radius.*"],
      "evidence_kinds": ["proximity_matches"],
      "visualization": "table",
      "empty_state": "No qualifying retailer pairs were found within the configured radius.",
      "narrative_section_id": "proximity"
    },
    {
      "id": "products",
      "title": "Assortment and Brand Context",
      "kind": "product_table",
      "required": true,
      "metric_selectors": ["assortment.*"],
      "evidence_kinds": ["product_catalog", "classified_offers"],
      "visualization": "table",
      "empty_state": "No qualifying product evidence was produced.",
      "narrative_section_id": "products"
    },
    {
      "id": "assortment_analysis",
      "title": "Assortment Intelligence",
      "kind": "assortment",
      "required": true,
      "metric_selectors": ["assortment.*"],
      "evidence_kinds": [
        "classified_offers",
        "exact_matches",
        "normalized_matches"
      ],
      "visualization": "ranked_cards",
      "empty_state": "No qualifying assortment evidence was produced."
    },
    {
      "id": "recommendations",
      "title": "Recommended Actions",
      "kind": "recommendations",
      "required": true,
      "metric_selectors": ["comparison.*"],
      "evidence_kinds": [
        "exact_matches",
        "normalized_matches",
        "proximity_matches"
      ],
      "visualization": "ranked_cards",
      "empty_state": "No evidence-backed action met the reporting threshold.",
      "narrative_section_id": "recommendations"
    },
    {
      "id": "quality",
      "title": "Data Quality",
      "kind": "data_quality",
      "required": true,
      "metric_selectors": ["quality.*"],
      "evidence_kinds": ["validation_issues"],
      "visualization": "table",
      "empty_state": "Data-quality evidence is unavailable.",
      "narrative_section_id": "quality"
    },
    {
      "id": "methodology",
      "title": "Caveats and Assumptions",
      "kind": "methodology",
      "required": true,
      "metric_selectors": [],
      "evidence_kinds": ["source_manifest", "validation_issues"],
      "visualization": "none",
      "empty_state": "Methodology metadata is unavailable.",
      "narrative_section_id": "methodology"
    }
  ],
  "artifact_profiles": [
    {
      "artifact_type": "html",
      "section_ids": [
        "executive_summary",
        "kpis",
        "coverage",
        "price_position",
        "segments",
        "proximity",
        "products",
        "assortment_analysis",
