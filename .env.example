APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rci
APP_SESSION_SECRET=change-me
RCI_API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_RCI_API_URL=http://localhost:8000

# Product Pack authoring is server-to-server only. Use three unrelated random values in Railway.
# Keep the API token identical on web/api; the password and session secret belong to web only.
PRODUCT_PACK_BUILDER_ENABLED=false
PRODUCT_PACK_ADMIN_TOKEN=
PRODUCT_PACK_ADMIN_PASSWORD=
PRODUCT_PACK_SESSION_SECRET=
# Optional comma-separated exact origins for custom domains.
PRODUCT_PACK_ALLOWED_ORIGINS=
PRODUCT_PACK_VALIDATION_CLAIM_LIMIT=1
PRODUCT_PACK_VALIDATION_LEASE_SECONDS=900

METRICSCART_API_BASE_URL=https://api.metricscart.com
METRICSCART_API_KEY=
COLLECTION_PROVIDER=fake
METRICSCART_GLOBAL_RPS=2
METRICSCART_GLOBAL_RPM=108
METRICSCART_INITIAL_BACKOFF_SECONDS=30
METRICSCART_RATE_LIMIT_BACKOFF_SECONDS=120
METRICSCART_MAX_BACKOFF_SECONDS=900
METRICSCART_MAX_ATTEMPTS=5
METRICSCART_TIMEOUT_SECONDS=60

# Product Details enrichment remains off until an explicitly budgeted run is queued.
PRODUCT_DETAIL_ENRICHMENT_ENABLED=false
PRODUCT_DETAIL_RPS=3
PRODUCT_DETAIL_RPM=180
PRODUCT_DETAIL_CLAIM_LIMIT=1
PRODUCT_DETAIL_LEASE_SECONDS=300
PRODUCT_DETAIL_CACHE_TTL_SECONDS=604800
# Zero-credit replay of retained raw PDP payloads after normalizer upgrades.
PRODUCT_DETAIL_RENORMALIZATION_ENABLED=false
PRODUCT_DETAIL_RENORMALIZATION_CLAIM_LIMIT=8
PRODUCT_DETAIL_RENORMALIZATION_LEASE_SECONDS=300

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true

AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL_CLASSIFICATION=
OPENAI_MODEL_INSIGHT=
OPENAI_MODEL_NARRATIVE=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_MAX_REQUEST_COST_USD=1.00
AI_MAX_METRICS=360
AI_MAX_ATTEMPTS=2
AI_LEASE_SECONDS=900

WORKER_ID=
WORKER_CLAIM_LIMIT=10
WORKER_LEASE_SECONDS=300
ANALYSIS_PIPELINE_ENABLED=true
ANALYSIS_HISTORICAL_REPLAY_ENABLED=false
ANALYSIS_CLAIM_LIMIT=1
ANALYSIS_LEASE_SECONDS=600
ANALYSIS_MAX_ATTEMPTS=3
SCHEDULER_ID=
SCHEDULER_POLL_SECONDS=30
SCHEDULER_CLAIM_LIMIT=10
SCHEDULER_LEASE_SECONDS=300

EMAIL_PROVIDER=unavailable
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
LOG_LEVEL=INFO
# Optional local-only paths for the full strawberry golden regression.
RCI_GOLDEN_STRAWBERRIES_WALMART_CSV=
RCI_GOLDEN_STRAWBERRIES_ALDI_CSV=
RCI_GOLDEN_STRAWBERRIES_AMAZON_CSV=
# Optional local-only path for the consolidated full egg golden regression.
RCI_GOLDEN_EGGS_CSV=
