{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/analysis-result-v2.schema.json",
  "title": "Retail Competitive Intelligence Analysis Result V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_run_id",
    "generated_at",
    "source",
    "benchmark_retailer",
    "competitors",
    "product_pack",
    "retailer_packs",
    "metrics",
    "coverage",
    "comparison_modes",
    "segments",
    "comparisons",
    "geographic_sensitivity",
    "assortment",
    "data_quality",
    "validation",
    "insights",
    "recommendations",
    "narratives",
    "evidence_sets",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "benchmark_retailer": {
      "type": "string",
      "minLength": 1
    },
    "competitors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "product_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "checksum_sha256", "report_blueprint"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "report_blueprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "retailer_packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["retailer_id", "version", "checksum_sha256", "brand_foundation"],
        "properties": {
          "retailer_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "brand_foundation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "checksum_sha256"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["retailer_id", "metric_refs", "evidence_refs"],
        "properties": {
          "retailer_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_refs": {
            "$ref": "#/$defs/nonempty_refs"
          },
          "evidence_refs": {
            "$ref": "#/$defs/nonempty_refs"
          }
        }
      }
    },
    "comparison_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "label", "geography", "comparison_metric", "dimensions"],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "geography": {
            "enum": ["exact_zip", "same_store_market", "radius", "national"]
          },
          "comparison_metric": {
            "type": "string",
            "minLength": 1
          },
          "dimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relationship_scope_policy": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "label", "attributes", "metric_refs", "evidence_refs"],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "object"
          },
          "metric_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "$ref": "#/$defs/nonempty_refs"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "comparison_id",
          "competitor_id",
          "profile_id",
          "segment_id",
          "metric_refs",
          "evidence_refs"
        ],
        "properties": {
          "comparison_id": {
            "type": "string",
            "minLength": 1
          },
          "competitor_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_refs": {
            "$ref": "#/$defs/nonempty_refs"
          },
          "evidence_refs": {
            "$ref": "#/$defs/nonempty_refs"
          }
        }
      }
    },
    "geographic_sensitivity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "profile_id", "radius_miles", "metric_refs", "evidence_refs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "radius_miles": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "metric_refs": {
            "$ref": "#/$defs/nonempty_refs"
          },
          "evidence_refs": {
            "$ref": "#/$defs/nonempty_refs"
          }
        }
      }
    },
    "assortment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_refs", "evidence_refs"],
      "properties": {
        "metric_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "metric_refs", "issue_counts", "evidence_refs"],
      "properties": {
        "status": {
          "enum": ["ready", "warning", "blocked"]
        },
        "metric_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issue_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "golden_status",
        "unsupported_numeric_claims",
        "metric_reference_coverage",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": ["ready_to_share", "needs_review", "blocked"]
        },
        "golden_status": {
          "enum": ["not_applicable", "passed", "failed"]
        },
        "unsupported_numeric_claims": {
          "type": "integer",
          "minimum": 0
        },
        "metric_reference_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": ["passed", "failed", "warning"]
              },
              "evidence_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/insight"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "narratives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_mode", "sections"],
      "properties": {
        "generation_mode": {
          "enum": ["deterministic", "ai_assisted"]
        },
        "agent_task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/narrative_section"
          }
        }
      }
    },
    "evidence_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_set_id", "kind", "row_count", "checksum_sha256"],
        "properties": {
          "evidence_set_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "artifact_id", "checksum_sha256", "template_version"],
        "properties": {
          "artifact_type": {
            "enum": ["html", "xlsx", "leadership_email", "audit_zip"]
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "template_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analytics_code_version",
        "deterministic_result_checksum_sha256",
        "final_result_checksum_sha256",
        "raw_source_artifact_ids"
      ],
      "properties": {
        "analytics_code_version": {
          "type": "string",
          "minLength": 1
        },
        "deterministic_result_checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_result_checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_source_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_set_id", "kind", "sampling", "total_rows", "source_artifact_ids"],
      "properties": {
        "input_set_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["live_collection", "historical_import"]
        },
        "collection_run_id": {
          "type": ["string", "null"]
        },
        "match_revision_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "matching_v2_gold_set_release_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "matching_v2_gold_set_checksum": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "matching_v2_certification_coverage": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "authority", "queue_case_count", "certified_label_count",
            "certified_comparable_count", "certified_not_comparable_count",
            "unresolved_excluded_count", "automatic_fallback_enabled"
          ],
          "properties": {
            "authority": {"const": "matching_v2_certified_gold_set"},
            "source_candidate_count": {"type": "integer", "minimum": 0},
            "selected_candidate_count": {"type": "integer", "minimum": 0},
            "selection_complete": {"type": "boolean"},
            "selection_coverage_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "queue_case_count": {"type": "integer", "minimum": 0},
            "certified_label_count": {"type": "integer", "minimum": 0},
            "certified_comparable_count": {"type": "integer", "minimum": 0},
            "certified_not_comparable_count": {"type": "integer", "minimum": 0},
            "unresolved_excluded_count": {"type": "integer", "minimum": 0},
            "automatic_fallback_enabled": {"const": false},
            "retailers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "competitor_retailer_id", "candidate_count", "certified_count",
                  "certified_comparable_count", "certified_not_comparable_count",
                  "unresolved_count"
                ],
                "properties": {
                  "competitor_retailer_id": {"type": "string", "minLength": 1},
                  "candidate_count": {"type": "integer", "minimum": 0},
                  "certified_count": {"type": "integer", "minimum": 0},
                  "certified_comparable_count": {"type": "integer", "minimum": 0},
                  "certified_not_comparable_count": {"type": "integer", "minimum": 0},
                  "unresolved_count": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        },
        "brand_revision_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "source_analysis_id": {
          "type": ["string", "null"]
        },
        "observed_start": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "observed_end": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "sampling": {
          "type": "boolean"
        },
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "source_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "name", "value", "unit", "method", "source", "evidence_refs"],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "numerator": {
          "type": "number"
        },
        "denominator": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "deterministic"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        }
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "severity",
        "business_impact",
        "metric_refs",
        "evidence_refs",
        "confidence",
        "generated_by"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["positive", "info", "watch", "high", "critical"]
        },
        "business_impact": {
          "type": "string",
          "minLength": 1
        },
        "metric_refs": {
          "$ref": "#/$defs/nonempty_refs"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_by": {
          "enum": ["deterministic", "ai_assisted"]
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "action",
        "owner",
        "rationale",
        "metric_refs",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "metric_refs": {
          "$ref": "#/$defs/nonempty_refs"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        }
      }
    },
    "narrative_section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "heading", "body", "metric_refs", "evidence_refs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "bullets": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implication": {
          "type": "string"
        },
        "topic_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "data_scope",
              "footprint",
              "exact_price",
              "normalized_price",
              "segment_drivers",
              "segment_reversals",
              "geography",
              "fulfillment",
              "brand_assortment",
              "actions",
              "caveats"
            ]
          }
        },
        "storyline_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "product_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metric_refs": {
          "$ref": "#/$defs/nonempty_refs"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        }
      }
    },
    "nonempty_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
