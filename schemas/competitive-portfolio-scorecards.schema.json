{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/competitive-portfolio-scorecards.schema.json",
  "title": "RetailCompetitiveIntelligenceCompetitivePortfolioScorecards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "generated_at",
    "benchmark_retailer",
    "filters",
    "policy",
    "scorecards",
    "cohorts",
    "assortment_scorecards"
  ],
  "properties": {
    "schema_version": { "enum": ["1.1.0", "1.2.0", "1.3.0"] },
    "analysis_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "benchmark_retailer": { "$ref": "#/$defs/idName" },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competitor_id", "profile_id", "radius_miles", "state", "city"],
      "properties": {
        "competitor_id": { "type": "string", "minLength": 1 },
        "profile_id": { "type": "string", "minLength": 1 },
        "radius_miles": { "enum": [1, 3, 5] },
        "state": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_store_rule", "service_area_rule", "grain"],
      "properties": {
        "physical_store_rule": { "const": "within selected radius" },
        "service_area_rule": { "const": "same delivery ZIP" },
        "grain": { "type": "string", "minLength": 1 }
      }
    },
    "scorecards": {
      "type": "array",
      "items": { "$ref": "#/$defs/scorecard" }
    },
    "cohorts": {
      "type": "array",
      "items": { "$ref": "#/$defs/cohort" }
    },
    "assortment_scorecards": {
      "type": "array",
      "items": { "$ref": "#/$defs/assortmentScorecard" }
    }
  },
  "$defs": {
    "idName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "benchmark_product_locations",
        "scored_product_locations",
        "coverage_rate",
        "leader_product_locations",
        "tied_product_locations",
        "at_risk_product_locations",
        "losing_product_locations",
        "unscored_product_locations",
        "leader_rate",
        "benchmark_lower_rate",
        "competitor_lower_rate",
        "parity_rate",
        "average_gap"
      ],
      "properties": {
        "benchmark_product_locations": { "type": "integer", "minimum": 0 },
        "scored_product_locations": { "type": "integer", "minimum": 0 },
        "coverage_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "leader_product_locations": { "type": "integer", "minimum": 0 },
        "tied_product_locations": { "type": "integer", "minimum": 0 },
        "at_risk_product_locations": { "type": "integer", "minimum": 0 },
        "losing_product_locations": { "type": "integer", "minimum": 0 },
        "unscored_product_locations": { "type": "integer", "minimum": 0 },
        "leader_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "benchmark_lower_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "competitor_lower_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "parity_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "average_gap": { "type": ["number", "null"] }
      }
    },
    "productSummary": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/summary" },
        {
          "type": "object",
          "required": ["product_id", "product_name", "image_url", "relationships"],
          "properties": {
            "product_id": { "type": "string", "minLength": 1 },
            "product_name": { "type": "string", "minLength": 1 },
            "image_url": { "type": ["string", "null"] },
            "relationships": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "relationshipSummary": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/summary" },
        {
          "type": "object",
          "required": [
            "relationship_id",
            "competitor_id",
            "competitor_name",
            "benchmark_product_id",
            "benchmark_product_name",
            "benchmark_image_url",
            "competitor_product_id",
            "competitor_product_name",
            "competitor_brand",
            "competitor_brand_type",
            "competitor_image_url",
            "profile_id",
            "profile_label",
            "comparison_metric",
            "comparison_unit",
            "scope_mode",
            "scoped_benchmark_locations"
          ],
          "properties": {
            "relationship_id": { "type": "string", "minLength": 1 },
            "competitor_id": { "type": "string", "minLength": 1 },
            "competitor_name": { "type": "string", "minLength": 1 },
            "benchmark_product_id": { "type": "string", "minLength": 1 },
            "benchmark_product_name": { "type": "string", "minLength": 1 },
            "benchmark_image_url": { "type": ["string", "null"] },
            "competitor_product_id": { "type": "string", "minLength": 1 },
            "competitor_product_name": { "type": "string", "minLength": 1 },
            "competitor_brand": { "type": ["string", "null"] },
            "competitor_brand_type": {
              "enum": ["private_label", "regional", "national", "unclassified"]
            },
            "competitor_image_url": { "type": ["string", "null"] },
            "profile_id": { "type": "string", "minLength": 1 },
            "profile_label": { "type": "string", "minLength": 1 },
            "comparison_metric": { "type": "string", "minLength": 1 },
            "comparison_unit": { "type": "string", "minLength": 1 },
            "scope_mode": { "type": "string", "minLength": 1 },
            "scoped_benchmark_locations": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "scorecard": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/summary" },
        {
          "type": "object",
          "required": [
            "competitor_id",
            "competitor",
            "benchmark_products",
            "competitor_products",
            "relationships",
            "products"
          ],
          "properties": {
            "competitor_id": { "type": "string", "minLength": 1 },
            "competitor": { "type": "string", "minLength": 1 },
            "benchmark_products": { "type": "integer", "minimum": 0 },
            "competitor_products": { "type": "integer", "minimum": 0 },
            "relationships": { "type": "integer", "minimum": 0 },
            "products": {
              "type": "array",
              "items": { "$ref": "#/$defs/productSummary" }
            },
            "product_relationships": {
              "type": "array",
              "items": { "$ref": "#/$defs/relationshipSummary" }
            }
          }
        }
      ]
    },
    "cohort": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/summary" },
        {
          "type": "object",
          "required": [
            "id",
            "competitor_id",
            "competitor",
            "profile_id",
            "segment_id",
            "segment",
            "attributes",
            "relationships",
            "benchmark_products",
            "competitor_products",
            "benchmark_median",
            "competitor_median",
            "paired_median_gap",
            "dominant_outcome",
            "products"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "competitor_id": { "type": "string", "minLength": 1 },
            "competitor": { "type": "string", "minLength": 1 },
            "profile_id": { "type": "string", "minLength": 1 },
            "segment_id": { "type": "string", "minLength": 1 },
            "segment": { "type": "string", "minLength": 1 },
            "attributes": { "type": "object" },
            "relationships": { "type": "integer", "minimum": 0 },
            "benchmark_products": { "type": "integer", "minimum": 0 },
            "competitor_products": { "type": "integer", "minimum": 0 },
            "benchmark_median": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "competitor_median": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "paired_median_gap": { "type": ["number", "null"] },
            "dominant_outcome": {
              "enum": ["benchmark_lower", "competitor_lower", "parity", "unavailable"]
            },
            "products": {
              "type": "array",
              "items": { "$ref": "#/$defs/productSummary" }
            },
            "product_relationships": {
              "type": "array",
              "items": { "$ref": "#/$defs/relationshipSummary" }
            }
          }
        }
      ]
    },
    "assortmentScorecard": {
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/summary" },
        {
          "type": "object",
          "required": [
            "competitor_id",
            "competitor",
            "profile_id",
            "relationships",
            "matched_benchmark_products",
            "matched_competitor_products",
            "benchmark_only_products",
            "competitor_whitespace_products",
            "benchmark_match_coverage",
            "competitor_match_coverage",
            "profiles",
            "top_benchmark_only",
            "top_competitor_whitespace",
            "products"
          ],
          "properties": {
            "competitor_id": { "type": "string", "minLength": 1 },
            "competitor": { "type": "string", "minLength": 1 },
            "profile_id": { "type": "string", "minLength": 1 },
            "relationships": { "type": "integer", "minimum": 0 },
            "matched_benchmark_products": { "type": "integer", "minimum": 0 },
            "matched_competitor_products": { "type": "integer", "minimum": 0 },
            "benchmark_only_products": { "type": "integer", "minimum": 0 },
            "competitor_whitespace_products": { "type": "integer", "minimum": 0 },
            "benchmark_match_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "competitor_match_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "profiles": { "type": "array", "items": { "type": "object" } },
            "top_benchmark_only": { "type": "array", "items": { "type": "object" } },
            "top_competitor_whitespace": { "type": "array", "items": { "type": "object" } }
            ,"products": { "type": "array", "items": { "$ref": "#/$defs/productSummary" } }
          }
        }
      ]
    }
  }
}
