{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpghero.com/schemas/matching-v2-attribute-evidence-decision.schema.json",
  "title": "Matching v2 Attribute Evidence Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_id",
    "case_id",
    "reviewer_id",
    "proposal_checksum",
    "decision",
    "rationale"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "queue_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "reviewer_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "proposal_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["verified", "rejected"] },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "supersedes_decision_id": { "type": ["string", "null"], "format": "uuid" }
  }
}
