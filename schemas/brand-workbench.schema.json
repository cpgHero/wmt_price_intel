{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpghero.com/schemas/brand-workbench.schema.json",
  "title": "Retail Competitive Intelligence Brand Workbench",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "product_pack_id",
    "product_pack_version",
    "revision",
    "retailers",
    "brands",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "product_pack_id": { "type": "string", "minLength": 1 },
    "product_pack_version": { "type": "string", "minLength": 1 },
    "revision_id": { "type": ["string", "null"], "format": "uuid" },
    "revision": { "type": "integer", "minimum": 0 },
    "current_publication_revision_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "future_application": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision_id", "revision"],
          "properties": {
            "revision_id": { "type": "string", "format": "uuid" },
            "revision": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "retailers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "brands": {
      "type": "array",
      "items": { "$ref": "#/$defs/brand" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggested",
        "confirmed",
        "rejected",
        "unclassified",
        "candidate_matches",
        "ambiguous_matches"
      ],
      "properties": {
        "suggested": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "unclassified": { "type": "integer", "minimum": 0 },
        "candidate_matches": { "type": "integer", "minimum": 0 },
        "ambiguous_matches": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retailer_id",
        "normalized_brand",
        "display_brand",
        "role",
        "status",
        "origin",
        "observed_products",
        "observed_locations",
        "observed_zipcodes",
        "location_share",
        "distribution_tier",
        "distribution_evidence",
        "canonical_brand_id",
        "canonical_brand_name",
        "candidate_status",
        "candidate_matches",
        "product_examples"
      ],
      "properties": {
        "retailer_id": { "type": "string", "minLength": 1 },
        "normalized_brand": { "type": "string", "minLength": 1 },
        "display_brand": { "type": "string", "minLength": 1 },
        "role": { "enum": ["private_label", "regional", "national", "unclassified"] },
        "status": { "enum": ["suggested", "confirmed", "rejected", "unclassified"] },
        "origin": { "enum": ["product_pack", "deterministic", "user"] },
        "reason": { "type": ["string", "null"] },
        "canonical_brand_id": { "type": ["string", "null"] },
        "canonical_brand_name": { "type": ["string", "null"] },
        "candidate_status": {
          "enum": ["resolved", "governed", "candidate", "ambiguous", "none"]
        },
        "candidate_matches": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "observed_products": { "type": "integer", "minimum": 1 },
        "observed_locations": { "type": "integer", "minimum": 0 },
        "observed_zipcodes": { "type": "integer", "minimum": 0 },
        "location_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "distribution_tier": {
          "enum": ["unknown", "single_location", "concentrated", "multi_market", "broad"]
        },
        "distribution_evidence": {
          "enum": [
            "search_brand_field",
            "pdp_identity_joined_to_matched_search",
            "pdp_identity_only"
          ]
        },
        "product_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product_id", "name"],
            "properties": {
              "product_id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "image_url": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_brand_id",
        "canonical_brand_name",
        "role",
        "strict_private_label",
        "retailer_scope",
        "confidence_score",
        "rationale",
        "brand_bucket",
        "brand_class",
        "primary_category",
        "core_region"
      ],
      "properties": {
        "canonical_brand_id": { "type": "string", "minLength": 1 },
        "canonical_brand_name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["private_label", "regional", "national", "unclassified"] },
        "strict_private_label": { "type": "boolean" },
        "retailer_scope": { "type": "string", "minLength": 1 },
        "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "rationale": {
          "enum": [
            "quarantined_alias_conflict",
            "same_core_name",
            "name_prefix",
            "token_overlap",
            "spelling_similarity"
          ]
        },
        "brand_bucket": { "type": "string", "minLength": 1 },
        "brand_class": { "type": "string", "minLength": 1 },
        "primary_category": { "type": ["string", "null"] },
        "core_region": { "type": ["string", "null"] }
      }
    }
  }
}
