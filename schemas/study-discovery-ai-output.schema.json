{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/study-discovery-ai-output.schema.json",
  "title": "Retail Competitive Intelligence Study Discovery AI Suggestion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "summary",
    "suggestions",
    "unknowns",
    "required_human_checks"
  ],
  "properties": {
    "kind": {
      "enum": [
        "query_plan",
        "product_pack_hypothesis"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "suggestions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keyword": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "alternate_queries": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "target_terms": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "exclusion_terms": {
          "type": "array",
          "maxItems": 80,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "attribute_hypotheses": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "label",
              "data_type",
              "matching_relevance",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "data_type": {
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "enum"
                ]
              },
              "matching_relevance": {
                "enum": [
                  "strict",
                  "normalized",
                  "identity",
                  "reporting_only"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "required_human_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
