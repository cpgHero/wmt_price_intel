{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/product-pack.schema.json",
  "title": "Retail Competitive Intelligence Product Pack",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "category_family",
    "scope",
    "attributes",
    "normalization",
    "matching_profiles",
    "qa_rules",
    "reporting"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "category_family": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hard_exclusion_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_terms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "availability_policy": {
          "enum": [
            "search_presence",
            "in_stock_only",
            "retailer_specific"
          ]
        },
        "require_positive_price": {
          "type": "boolean"
        }
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "data_type",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "data_type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "enum",
              "array"
            ]
          },
          "role": {
            "enum": [
              "identity",
              "matching",
              "normalization",
              "reporting",
              "qa"
            ]
          },
          "required_for_strict": {
            "type": "boolean"
          },
          "allowed_values": {
            "type": "array"
          },
          "unknown_values": {
            "type": "array",
            "items": {}
          },
          "synonyms": {
            "type": "object"
          },
          "unit": {
            "type": "string"
          },
          "unknown_policy": {
            "enum": [
              "reject_strict",
              "allow_compatible",
              "infer",
              "review",
              "not_applicable"
            ]
          },
          "extractors": {
            "type": "array",
            "items": {
              "enum": [
                "title_rule",
                "url_rule",
                "retailer_field",
                "cross_product_inference",
                "ai_fallback",
                "manual"
              ]
            }
          },
          "extraction_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "constant",
                    "field",
                    "measurement",
                    "number_pattern",
                    "term_map",
                    "boolean_terms"
                  ]
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "value": {},
                "units": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "patterns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "group": {
                  "type": "integer",
                  "minimum": 1
                },
                "values": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "true_terms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "false_terms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "absence_policy": {
                  "enum": ["unknown", "infer_default"]
                },
                "default": {}
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "normalization": {
      "type": "object",
      "required": [
        "primary_display_metric"
      ],
      "properties": {
        "primary_display_metric": {
          "type": "string"
        },
        "secondary_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conversion_rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "forbidden_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "package_equivalence_policy": {
          "enum": [
            "exact_package_first",
            "unit_normalized_only",
            "category_specific"
          ]
        }
      }
    },
    "matching_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "geography",
          "dimensions",
          "brand_policy"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "geography": {
            "enum": [
              "exact_zip",
              "same_store_market",
              "radius",
              "national"
            ]
          },
          "radius_miles": {
            "type": "number"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attribute_constraints": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1
            }
          },
          "benchmark_attribute_constraints": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1
            }
          },
          "competitor_attribute_constraints": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1
            }
          },
          "brand_policy": {
            "enum": [
              "same_brand",
              "private_label_equivalent",
              "ignore_brand",
              "category_specific"
            ]
          },
          "unknown_policy": {
            "enum": [
              "reject",
              "wildcard_if_one_unknown",
              "allow",
              "review"
            ]
          },
          "wildcard_dimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "price_selection": {
            "enum": [
              "lowest_positive",
              "median",
              "retailer_primary_offer"
            ]
          },
          "comparison_metric": {
            "type": "string",
            "minLength": 1
          },
          "comparison_interval": {
            "type": "object",
            "required": ["low_metric", "high_metric"],
            "properties": {
              "low_metric": {
                "type": "string",
                "minLength": 1
              },
              "high_metric": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "availability_policy": {
            "enum": [
              "search_presence",
              "in_stock_only",
              "retailer_specific"
            ]
          },
          "relationship_scope_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "default_scope_mode",
              "allow_scoped_reuse",
              "relationship_role",
              "conflict_behavior",
              "comparison_context_grain"
            ],
            "properties": {
              "default_scope_mode": {
                "enum": [
                  "global",
                  "observed_benchmark_product_footprint",
                  "explicit_benchmark_locations"
                ]
              },
              "allow_scoped_reuse": { "type": "boolean" },
              "relationship_role": { "enum": ["primary", "alternative"] },
              "conflict_behavior": { "const": "exclude_from_price_comparison" },
              "comparison_context_grain": {
                "enum": ["benchmark_location", "benchmark_zip"]
              },
              "minimum_locations": { "type": "integer", "minimum": 1 },
              "future_location_policy": {
                "enum": ["require_review", "inherit_observed_footprint"]
              }
            }
          }
        }
      }
    },
    "matching_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "certification_state",
        "attribute_roles",
        "exact_item_identifier_schemes",
        "eligible_price_bases",
        "price_basis_requirements",
        "minimum_equivalent_coverage",
        "equivalent_score_threshold",
        "allow_comparable_substitute",
        "auto_approval_tiers",
        "geography_policy",
        "scope_mode",
        "fulfillment_types"
      ],
      "properties": {
        "policy_version": { "type": "string", "minLength": 1 },
        "certification_state": { "enum": ["draft", "shadow", "certified"] },
        "attribute_roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "critical", "weight"],
            "properties": {
              "role": {
                "enum": [
                  "identity",
                  "hard_blocker",
                  "required_exact",
                  "soft_comparator",
                  "descriptive",
                  "ignored"
                ]
              },
              "critical": { "type": "boolean" },
              "weight": { "type": "number", "minimum": 0 },
              "numeric_tolerance": { "type": "number", "minimum": 0 },
              "unknown_is_blocking": { "type": "boolean" }
            }
          }
        },
        "exact_item_identifier_schemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["gtin", "upc", "manufacturer_item_id"]
          }
        },
        "eligible_price_bases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "exact_package",
              "normalized_unit",
              "random_weight_unit"
            ]
          }
        },
        "price_basis_requirements": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": ["exact_package", "normalized_unit", "random_weight_unit"]
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "minimum_equivalent_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "equivalent_score_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allow_comparable_substitute": { "type": "boolean" },
        "auto_approval_tiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["exact_item", "exact_specification"] }
        },
        "geography_policy": {
          "enum": [
            "same_zip",
            "physical_store_radius",
            "nearest_store",
            "service_area",
            "merchant_market",
            "national"
          ]
        },
        "scope_mode": {
          "enum": ["global", "observed_distribution", "explicit_locations", "regional"]
        },
        "fulfillment_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "maximum_candidate_pairs": {
          "type": "integer",
          "minimum": 1,
          "default": 250000
        },
        "candidate_geography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "physical_radius_miles",
            "service_area_retailer_ids",
            "service_area_overlap_policy",
            "missing_location_policy"
          ],
          "properties": {
            "mode": { "enum": ["disabled", "observed_overlap"] },
            "physical_radius_miles": { "type": "number", "exclusiveMinimum": 0 },
            "service_area_retailer_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "service_area_overlap_policy": { "enum": ["same_zip"] },
            "missing_location_policy": { "enum": ["fail_closed", "allow"] }
          }
        },
        "candidate_retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "maximum_per_benchmark", "minimum_similarity", "stop_words"],
          "properties": {
            "mode": { "enum": ["disabled", "lexical_top_k"] },
            "maximum_per_benchmark": { "type": "integer", "minimum": 1 },
            "minimum_similarity": { "type": "number", "minimum": 0, "maximum": 1 },
            "stop_words": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "brand_rules": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "private_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "portfolios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "role", "retailer_ids", "brands"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "label": { "type": "string", "minLength": 1 },
              "role": {
                "enum": ["private_label", "regional", "national", "unclassified"]
              },
              "retailer_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "brands": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "evidence_notes": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "qa_rules": {
      "type": "object",
      "properties": {
        "parity_tolerance_dollars": {
          "type": "number"
        },
        "min_price": {
          "type": "number"
        },
        "max_price": {
          "type": "number"
        },
        "suspicious_gap_pct": {
          "type": "number"
        },
        "require_unit_confirmation_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_review_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitivity_checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "retailer_overrides": {
      "type": "object"
    },
        "reporting": {
            "type": "object",
            "required": [
                "headline_segments",
                "required_caveats",
                "report_blueprint",
                "narrative_playbook",
                "insight_ranking",
                "insight_rules"
            ],
            "properties": {
        "headline_segments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_charts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brand_portfolio_panels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "profile_id",
              "benchmark_portfolio_ids",
              "competitor_portfolio_ids",
              "question"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "label": { "type": "string", "minLength": 1 },
              "profile_id": { "type": "string", "minLength": 1 },
              "benchmark_portfolio_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "competitor_portfolio_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "question": { "type": "string", "minLength": 1 }
            }
          }
        },
                "decision_rules": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "preferred_scorecard_profile_id",
                        "profile_priority",
                        "minimum_observations",
                        "minimum_geographies",
                        "executive_relationship_states",
                        "extreme_gap_behavior",
                        "parity_display"
                    ],
                    "properties": {
                        "preferred_scorecard_profile_id": {
                            "type": "string",
                            "minLength": 1
                        },
                        "profile_priority": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "minimum_observations": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "minimum_geographies": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "executive_relationship_states": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "enum": ["suggested", "confirmed"]
                            }
                        },
                        "extreme_gap_behavior": {
                            "enum": ["review", "suppress"]
                        },
                        "parity_display": {
                            "enum": ["include", "hide_when_zero"]
                        }
                    }
                },
                "alertable_metrics": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "report_blueprint": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "version"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "pattern": "^[a-z0-9_]+$"
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "narrative_playbook": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "leadership_objective",
                        "required_topics",
                        "decision_lenses",
                        "action_principles",
                        "forbidden_claims",
                        "small_sample_threshold"
                    ],
                    "properties": {
                        "leadership_objective": {
                            "type": "string",
                            "minLength": 1
                        },
                        "required_topics": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "enum": [
                                    "data_scope",
                                    "footprint",
                                    "exact_price",
                                    "normalized_price",
                                    "segment_drivers",
                                    "segment_reversals",
                                    "geography",
                                    "fulfillment",
                                    "brand_assortment",
                                    "actions",
                                    "caveats"
                                ]
                            }
                        },
                        "decision_lenses": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["id", "label", "question", "metric_selectors"],
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "pattern": "^[a-z0-9_]+$"
                                    },
                                    "label": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "question": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "metric_selectors": {
                                        "type": "array",
                                        "minItems": 1,
                                        "uniqueItems": true,
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        }
                                    }
                                }
                            }
                        },
                        "action_principles": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "forbidden_claims": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "small_sample_threshold": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "story_priorities": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "id",
                                    "kind",
                                    "headline",
                                    "objective",
                                    "topic_refs",
                                    "section_ids",
                                    "max_facts"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string",
                                        "pattern": "^[a-z0-9_]+$"
                                    },
                                    "kind": {
                                        "enum": [
                                            "competitive_pressure",
                                            "benchmark_strength",
                                            "mixed_position",
                                            "segment_reversal",
                                            "geographic_validation",
                                            "action"
                                        ]
                                    },
                                    "headline": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "objective": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "topic_refs": {
                                        "type": "array",
                                        "minItems": 1,
                                        "uniqueItems": true,
                                        "items": {
                                            "enum": [
                                                "data_scope",
                                                "footprint",
                                                "exact_price",
                                                "normalized_price",
                                                "segment_drivers",
                                                "segment_reversals",
                                                "geography",
                                                "fulfillment",
                                                "brand_assortment",
                                                "actions",
                                                "caveats"
                                            ]
                                        }
                                    },
                                    "section_ids": {
                                        "type": "array",
                                        "minItems": 1,
                                        "uniqueItems": true,
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        }
                                    },
                                    "competitor_ids": {
                                        "type": "array",
                                        "uniqueItems": true,
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        }
                                    },
                                    "profile_ids": {
                                        "type": "array",
                                        "uniqueItems": true,
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        }
                                    },
                                    "segment_scope": {
                                        "enum": ["overall", "segment", "any"]
                                    },
                                    "significances": {
                                        "type": "array",
                                        "uniqueItems": true,
                                        "items": {
                                            "enum": ["strength", "watch", "risk", "caveat"]
                                        }
                                    },
                                    "segment_attribute_constraints": {
                                        "type": "object"
                                    },
                                    "max_facts": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 12
                                    }
                                }
                            }
