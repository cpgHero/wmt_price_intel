{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/competitive-product-coverage.schema.json",
  "title": "RetailCompetitiveIntelligenceCompetitiveProductCoverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "benchmark_retailer",
    "competitor",
    "profile_id",
    "radius_miles",
    "evidence_funnel",
    "products"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "benchmark_retailer": { "$ref": "#/$defs/idName" },
    "competitor": { "$ref": "#/$defs/idName" },
    "profile_id": { "type": "string", "minLength": 1 },
    "radius_miles": { "enum": [1, 3, 5] },
    "evidence_funnel": { "$ref": "#/$defs/evidenceFunnel" },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "idName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceFunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_products",
        "in_scope_catalog_products",
        "observed_catalog_products",
        "certified_identity_products",
        "selected_price_basis_products",
        "locally_scored_products",
        "scored_product_locations",
        "status_counts"
      ],
      "properties": {
        "catalog_products": { "type": "integer", "minimum": 0 },
        "in_scope_catalog_products": { "type": "integer", "minimum": 0 },
        "observed_catalog_products": { "type": "integer", "minimum": 0 },
        "certified_identity_products": { "type": "integer", "minimum": 0 },
        "selected_price_basis_products": { "type": "integer", "minimum": 0 },
        "locally_scored_products": { "type": "integer", "minimum": 0 },
        "scored_product_locations": { "type": "integer", "minimum": 0 },
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "benchmark_not_observed",
            "no_certified_relationship",
            "no_selected_price_basis",
            "no_local_competitor_evidence",
            "scored",
            "governed_out_of_scope"
          ],
          "properties": {
            "benchmark_not_observed": { "type": "integer", "minimum": 0 },
            "no_certified_relationship": { "type": "integer", "minimum": 0 },
            "no_selected_price_basis": { "type": "integer", "minimum": 0 },
            "no_local_competitor_evidence": { "type": "integer", "minimum": 0 },
            "scored": { "type": "integer", "minimum": 0 },
            "governed_out_of_scope": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "product_name",
        "image_url",
        "observed_locations",
        "status",
        "certified_relationships",
        "selected_price_basis_relationships",
        "selected_competitor_products",
        "scored_product_locations"
      ],
      "properties": {
        "product_id": { "type": "string", "minLength": 1 },
        "product_name": { "type": "string", "minLength": 1 },
        "image_url": { "type": ["string", "null"] },
        "observed_locations": { "type": "integer", "minimum": 0 },
        "status": {
          "enum": [
            "benchmark_not_observed",
            "no_certified_relationship",
            "no_selected_price_basis",
            "no_local_competitor_evidence",
            "scored",
            "governed_out_of_scope"
          ]
        },
        "certified_relationships": { "type": "integer", "minimum": 0 },
        "selected_price_basis_relationships": { "type": "integer", "minimum": 0 },
        "selected_competitor_products": { "type": "integer", "minimum": 0 },
        "scored_product_locations": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
