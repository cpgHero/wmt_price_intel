{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpghero.com/schemas/brand-discovery-record.schema.json",
  "title": "Retail Competitive Intelligence Brand Discovery Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_id",
    "observed_retailer_id",
    "observed_brand_raw",
    "observed_brand_normalized",
    "observed_domain",
    "observed_at",
    "source_collection",
    "proposed_brand_bucket",
    "proposed_brand_class",
    "evidence_type",
    "evidence_count",
    "exclusivity_signal",
    "retailer_brand_page_signal",
    "confidence_score",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "queue_id": { "type": "string", "minLength": 1 },
    "observed_retailer_id": { "type": "string", "minLength": 1 },
    "observed_brand_raw": { "type": "string", "minLength": 1 },
    "observed_brand_normalized": { "type": "string", "minLength": 1 },
    "observed_product_title": { "type": ["string", "null"] },
    "observed_url": { "type": ["string", "null"], "format": "uri" },
    "observed_domain": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "source_collection": { "type": "string", "minLength": 1 },
    "source_job_id": { "type": ["string", "null"] },
    "proposed_brand_bucket": { "const": "Candidate/Unknown" },
    "proposed_brand_class": { "const": "candidate_unknown" },
    "proposed_canonical_brand_id": { "type": ["string", "null"] },
    "evidence_type": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "retailer_corporate_brand_page",
          "first_party_pdp_legal_signal",
          "multiple_first_party_pdp_exclusivity",
          "credible_secondary",
          "isolated_search_observation"
        ]
      }
    },
    "evidence_count": { "type": "integer", "minimum": 1 },
    "exclusivity_signal": { "enum": [true, false, "unknown"] },
    "distributor_signal": { "type": ["string", "null"] },
    "retailer_brand_page_signal": { "type": "boolean" },
    "first_party_source_url": { "type": ["string", "null"], "format": "uri" },
    "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "duplicate_candidate_of": { "type": ["string", "null"] },
    "review_status": { "enum": ["Pending", "Approved", "Rejected", "Needs Evidence"] },
    "reviewer": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "decision": {
      "type": ["string", "null"],
      "enum": [null, "map_existing", "create_private_label", "create_regional", "create_national", "reject", "needs_evidence"]
    },
    "decision_notes": { "type": ["string", "null"] }
  }
}
