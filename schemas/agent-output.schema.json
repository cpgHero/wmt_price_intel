{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/agent-output.schema.json",
  "title": "Retail Competitive Intelligence Governed Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "analysis_id",
    "role",
    "prompt_template",
    "model",
    "input_checksum_sha256",
    "output_checksum_sha256",
    "evidence_refs",
    "generated_at",
    "authoritative_metrics_computed",
    "result",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": ["classification_fallback", "comparison_qa", "insight", "narrative"]
    },
    "prompt_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "checksum_sha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "authoritative_metrics_computed": {
      "const": false
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unsupported_numeric_claims", "metric_reference_coverage"],
      "properties": {
        "status": {
          "enum": ["pending", "passed", "failed", "needs_review"]
        },
        "unsupported_numeric_claims": {
          "type": "integer",
          "minimum": 0
        },
        "metric_reference_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "classification_fallback"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/classification_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "comparison_qa"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/comparison_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "insight"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/insight_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "narrative"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/narrative_result"
          }
        }
      }
    }
  ],
  "$defs": {
    "classification_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "attributes", "confidence", "rationale", "evidence_refs"],
      "properties": {
        "decision": {
          "enum": ["include", "exclude", "review"]
        },
        "attributes": {
          "type": "object"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        }
      }
    },
    "comparison_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "issue_codes", "confidence", "rationale", "evidence_refs"],
      "properties": {
        "decision": {
          "enum": ["accept", "reject", "review"]
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        }
      }
    },
    "insight_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insights"],
      "properties": {
        "insights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/insight"
          }
        }
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "severity",
        "business_impact",
        "metric_refs",
        "evidence_refs",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["positive", "info", "watch", "high", "critical"]
        },
        "business_impact": {
          "type": "string",
          "minLength": 1
        },
        "metric_refs": {
          "$ref": "#/$defs/nonempty_refs"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_refs"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "narrative_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "heading", "body", "metric_refs", "evidence_refs"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "metric_refs": {
                "$ref": "#/$defs/nonempty_refs"
              },
              "evidence_refs": {
                "$ref": "#/$defs/nonempty_refs"
              }
            }
          }
        }
      }
    },
    "nonempty_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
