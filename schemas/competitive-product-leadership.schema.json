{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/competitive-product-leadership.schema.json",
  "title": "RetailCompetitiveIntelligenceCompetitiveProductLeadership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "generated_at",
    "benchmark_retailer",
    "benchmark_product",
    "competitors",
    "filters",
    "filter_options",
    "policy",
    "summary",
    "price_ladder_summary",
    "state_summaries",
    "city_summaries",
    "competitor_summaries",
    "relationships",
    "outcomes"
  ],
  "properties": {
    "schema_version": { "const": "1.2.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "benchmark_retailer": { "$ref": "#/$defs/idName" },
    "benchmark_product": { "$ref": "#/$defs/productOption" },
    "competitors": {
      "type": "array",
      "items": { "$ref": "#/$defs/idName" }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competitor_id",
        "profile_id",
        "radius_miles",
        "state",
        "city"
      ],
      "properties": {
        "competitor_id": { "type": "string", "minLength": 1 },
        "profile_id": { "type": "string", "minLength": 1 },
        "radius_miles": { "enum": [1, 3, 5] },
        "state": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] }
      }
    },
    "filter_options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products", "competitors", "profiles", "radii_miles", "states", "cities"],
      "properties": {
        "products": {
          "type": "array",
          "items": { "$ref": "#/$defs/productOption" }
        },
        "competitors": {
          "type": "array",
          "items": { "$ref": "#/$defs/idName" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/idName" }
        },
        "radii_miles": {
          "type": "array",
          "prefixItems": [{ "const": 1 }, { "const": 3 }, { "const": 5 }],
          "items": false
        },
        "states": {
          "type": "array",
          "items": { "$ref": "#/$defs/filterOption" }
        },
        "cities": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/filterOption" },
              {
                "type": "object",
                "required": ["state"],
                "properties": { "state": { "type": "string", "minLength": 1 } }
              }
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price_authority",
        "identity_authority",
        "location_authority",
        "observation_definition",
        "comparison_definition",
        "comparison_metric",
        "comparison_unit",
        "parity_tolerance",
        "at_risk_threshold",
        "status_definition"
      ],
      "properties": {
        "price_authority": { "const": "Search" },
        "identity_authority": { "type": "string", "minLength": 1 },
        "location_authority": { "const": "Retailer location master" },
        "observation_definition": { "type": "string", "minLength": 1 },
        "comparison_definition": { "type": "string", "minLength": 1 },
        "comparison_metric": { "type": "string", "minLength": 1 },
        "comparison_unit": { "type": "string", "minLength": 1 },
        "parity_tolerance": { "type": "number", "minimum": 0 },
        "at_risk_threshold": { "type": "number", "exclusiveMinimum": 0 },
        "status_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leader", "tied", "at_risk", "losing", "unscored"],
          "properties": {
            "leader": { "type": "string", "minLength": 1 },
            "tied": { "type": "string", "minLength": 1 },
            "at_risk": { "type": "string", "minLength": 1 },
            "losing": { "type": "string", "minLength": 1 },
            "unscored": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "price_ladder_summary": { "$ref": "#/$defs/footprintPriceLadder" },
    "state_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/geographySummary" }
    },
    "city_summaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/geographySummary" }
    },
    "competitor_summaries": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/summary" },
          {
            "type": "object",
            "required": ["competitor_id", "competitor"],
            "properties": {
              "competitor_id": { "type": "string", "minLength": 1 },
              "competitor": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/outcome" }
    }
  },
  "$defs": {
    "idName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "productOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "image_url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "image_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "filterOption": {
      "type": "object",
      "additionalProperties": true,
      "required": ["value", "label", "count"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "benchmark_observed_stores",
        "scored_stores",
        "coverage_rate",
        "leader_stores",
        "tied_stores",
        "at_risk_stores",
        "losing_stores",
        "unscored_stores",
        "leader_rate",
        "average_gap",
        "average_losing_gap",
        "maximum_losing_gap"
      ],
      "properties": {
        "benchmark_observed_stores": { "type": "integer", "minimum": 0 },
        "scored_stores": { "type": "integer", "minimum": 0 },
        "coverage_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "leader_stores": { "type": "integer", "minimum": 0 },
        "tied_stores": { "type": "integer", "minimum": 0 },
        "at_risk_stores": { "type": "integer", "minimum": 0 },
        "losing_stores": { "type": "integer", "minimum": 0 },
        "unscored_stores": { "type": "integer", "minimum": 0 },
        "leader_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "average_gap": { "type": ["number", "null"] },
        "average_losing_gap": { "type": ["number", "null"], "minimum": 0 },
        "maximum_losing_gap": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "geographySummary": {
      "allOf": [
        { "$ref": "#/$defs/summary" },
        {
          "type": "object",
          "required": ["id", "level", "label"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "level": { "enum": ["state", "city"] },
            "label": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retailer_id",
        "retailer_name",
        "product_id",
        "product_name",
        "brand",
        "brand_type",
        "brand_origin",
        "brand_status",
        "image_url",
        "product_url",
        "scope_key",
        "location_kind",
        "store_number",
        "store_name",
        "zipcode",
        "city",
        "state",
        "country",
        "latitude",
        "longitude",
        "package_price",
        "regular_price",
        "discounted_price",
        "is_sponsored",
        "in_stock",
        "offer_id",
        "comparison_value",
        "observed_at"
      ],
      "properties": {
        "retailer_id": { "type": "string", "minLength": 1 },
        "retailer_name": { "type": "string", "minLength": 1 },
        "product_id": { "type": "string", "minLength": 1 },
        "product_name": { "type": "string", "minLength": 1 },
        "brand": { "type": ["string", "null"] },
        "brand_type": {
          "enum": ["private_label", "regional", "national", "unclassified"]
        },
        "brand_origin": {
          "enum": ["user", "retailer_pack", "search", "pdp", "unresolved"]
        },
        "brand_status": { "type": "string", "minLength": 1 },
        "image_url": { "type": ["string", "null"], "format": "uri" },
        "product_url": { "type": ["string", "null"], "format": "uri" },
        "scope_key": { "type": "string", "minLength": 1 },
        "location_kind": { "enum": ["store", "service_area"] },
        "store_number": { "type": ["string", "null"] },
        "store_name": { "type": ["string", "null"] },
        "zipcode": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "country": { "type": "string", "minLength": 1 },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "package_price": { "type": "number", "exclusiveMinimum": 0 },
        "regular_price": { "type": ["number", "null"], "minimum": 0 },
        "discounted_price": { "type": ["number", "null"], "minimum": 0 },
        "is_sponsored": { "type": ["boolean", "null"] },
        "in_stock": { "type": "boolean" },
        "offer_id": { "type": ["string", "null"] },
        "comparison_value": { "type": "number", "exclusiveMinimum": 0 },
        "observed_at": { "type": ["string", "null"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "benchmark",
        "competitor",
        "relationship_id",
        "distance_miles",
        "competitor_minus_benchmark",
        "comparison_value_reduction_to_lead"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["leader", "tied", "at_risk", "losing", "unscored"] },
        "benchmark": { "$ref": "#/$defs/location" },
        "competitor": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/location" }]
        },
        "relationship_id": { "type": ["string", "null"] },
        "distance_miles": { "type": ["number", "null"], "minimum": 0 },
        "competitor_minus_benchmark": { "type": ["number", "null"] },
        "comparison_value_reduction_to_lead": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "footprintPriceLadder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "benchmark_observed_locations",
        "comparable_benchmark_locations",
        "benchmark_rank_one_locations",
        "benchmark_rank_one_rate",
        "median_benchmark_rank",
        "rows"
      ],
      "properties": {
        "definition": { "type": "string", "minLength": 1 },
        "benchmark_observed_locations": { "type": "integer", "minimum": 0 },
        "comparable_benchmark_locations": { "type": "integer", "minimum": 0 },
        "benchmark_rank_one_locations": { "type": "integer", "minimum": 0 },
        "benchmark_rank_one_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "median_benchmark_rank": { "type": ["number", "null"], "minimum": 1 },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/footprintPriceLadderRow" }
        }
      }
    },
    "footprintPriceLadderRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "retailer_id",
        "retailer_name",
        "product_id",
        "product_name",
        "brand",
        "brand_type",
        "image_url",
        "is_benchmark",
        "comparison_locations",
        "footprint_rate",
        "price_median",
        "price_minimum",
        "price_maximum",
        "median_gap_to_benchmark",
        "below_benchmark_locations",
        "tied_benchmark_locations",
        "above_benchmark_locations"
      ],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "retailer_id": { "type": "string", "minLength": 1 },
        "retailer_name": { "type": "string", "minLength": 1 },
        "product_id": { "type": "string", "minLength": 1 },
        "product_name": { "type": "string", "minLength": 1 },
        "brand": { "type": ["string", "null"] },
        "brand_type": { "enum": ["private_label", "regional", "national", "unclassified"] },
        "image_url": { "type": ["string", "null"], "format": "uri" },
        "is_benchmark": { "type": "boolean" },
        "comparison_locations": { "type": "integer", "minimum": 0 },
        "footprint_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "price_median": { "type": "number", "exclusiveMinimum": 0 },
        "price_minimum": { "type": "number", "exclusiveMinimum": 0 },
        "price_maximum": { "type": "number", "exclusiveMinimum": 0 },
        "median_gap_to_benchmark": { "type": ["number", "null"] },
        "below_benchmark_locations": { "type": "integer", "minimum": 0 },
        "tied_benchmark_locations": { "type": "integer", "minimum": 0 },
        "above_benchmark_locations": { "type": "integer", "minimum": 0 }
      }
    },
    "priceLadder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "rung_count",
        "benchmark_rank",
        "lower_priced_alternatives",
        "gap_to_leader",
        "gap_to_next_lower",
        "gap_to_next_higher",
        "rungs"
      ],
      "properties": {
        "definition": { "type": "string", "minLength": 1 },
        "rung_count": { "type": "integer", "minimum": 1 },
        "benchmark_rank": { "type": "integer", "minimum": 1 },
        "lower_priced_alternatives": { "type": "integer", "minimum": 0 },
        "gap_to_leader": { "type": "number", "minimum": 0 },
        "gap_to_next_lower": { "type": ["number", "null"], "minimum": 0 },
        "gap_to_next_higher": { "type": ["number", "null"], "minimum": 0 },
        "rungs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/priceLadderRung" }
        }
      }
    },
    "priceLadderRung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "price_rank",
        "is_benchmark",
        "relationship_id",
        "distance_miles",
        "location",
        "gap_to_previous",
        "gap_to_benchmark",
        "premium_vs_opening_rate"
      ],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "price_rank": { "type": "integer", "minimum": 1 },
        "is_benchmark": { "type": "boolean" },
        "relationship_id": { "type": ["string", "null"] },
        "distance_miles": { "type": ["number", "null"], "minimum": 0 },
        "location": { "$ref": "#/$defs/location" },
        "gap_to_previous": { "type": ["number", "null"], "minimum": 0 },
        "gap_to_benchmark": { "type": "number" },
        "premium_vs_opening_rate": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "competitor_id",
        "competitor_name",
        "benchmark_product_id",
        "benchmark_product_name",
        "benchmark_image_url",
        "competitor_product_id",
        "competitor_product_name",
        "competitor_brand",
        "competitor_brand_type",
        "competitor_image_url",
        "profile_id",
        "profile_label",
        "comparison_metric",
        "comparison_unit",
        "scope_mode",
        "scoped_benchmark_locations"
      ],
      "properties": {
        "relationship_id": { "type": "string", "minLength": 1 },
        "competitor_id": { "type": "string", "minLength": 1 },
        "competitor_name": { "type": "string", "minLength": 1 },
        "benchmark_product_id": { "type": "string", "minLength": 1 },
        "benchmark_product_name": { "type": "string", "minLength": 1 },
        "benchmark_image_url": { "type": ["string", "null"], "format": "uri" },
        "competitor_product_id": { "type": "string", "minLength": 1 },
        "competitor_product_name": { "type": "string", "minLength": 1 },
        "competitor_brand": { "type": ["string", "null"] },
        "competitor_brand_type": { "enum": ["private_label", "regional", "national", "unclassified"] },
        "competitor_image_url": { "type": ["string", "null"], "format": "uri" },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_label": { "type": "string", "minLength": 1 },
        "comparison_metric": { "type": "string", "minLength": 1 },
        "comparison_unit": { "type": "string", "minLength": 1 },
        "scope_mode": { "type": "string", "minLength": 1 },
        "scoped_benchmark_locations": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
