{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpghero.com/schemas/matching-v2-gold-set.schema.json",
  "title": "Matching Architecture v2 Human Gold Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gold_set_id",
    "version",
    "purpose",
    "product_pack",
    "source_evidence",
    "labels"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "coverage_contract_version": { "type": "string", "minLength": 1 },
    "gold_set_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "enum": ["contract_fixture", "release_certification"] },
    "product_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "benchmark_listing_id",
          "competitor_listing_id",
          "expected_comparable",
          "allowed_tiers",
          "critical",
          "stratum",
          "review_status",
          "reviewers",
          "evidence_refs",
          "rationale"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "benchmark_listing_id": { "type": "string", "minLength": 1 },
          "competitor_listing_id": { "type": "string", "minLength": 1 },
          "expected_comparable": { "type": "boolean" },
          "allowed_tiers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "exact_item",
                "exact_specification",
                "equivalent_product",
                "comparable_substitute",
                "custom_approved"
              ]
            }
          },
          "critical": { "type": "boolean" },
          "stratum": { "type": "string", "minLength": 1 },
          "review_status": {
            "enum": ["synthetic_fixture", "single_reviewed", "adjudicated"]
          },
          "reviewers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "expected_comparable": { "const": false } } },
            "then": { "properties": { "allowed_tiers": { "maxItems": 0 } } }
          }
        ]
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "benchmark_listing_id",
          "competitor_listing_id",
          "reason",
          "critical",
          "stratum",
          "review_status",
          "reviewers",
          "evidence_refs",
          "rationale"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "benchmark_listing_id": { "type": "string", "minLength": 1 },
          "competitor_listing_id": { "type": "string", "minLength": 1 },
          "reason": { "const": "insufficient_evidence" },
          "critical": { "type": "boolean" },
          "stratum": { "type": "string", "minLength": 1 },
          "review_status": {
            "enum": ["single_reviewed", "adjudicated"]
          },
          "reviewers": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "purpose": { "const": "release_certification" } } },
      "then": {
        "properties": {
          "labels": {
            "items": {
              "properties": {
                "review_status": {
                  "enum": ["single_reviewed", "adjudicated"]
                },
                "reviewers": { "minItems": 1 },
                "evidence_refs": { "minItems": 1 }
              }
            }
          },
          "exclusions": {
            "items": {
              "properties": {
                "reviewers": { "minItems": 1 },
                "evidence_refs": { "minItems": 1 }
              }
            }
          }
        }
      }
    }
  ]
}
