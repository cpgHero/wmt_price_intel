{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/price-observation.schema.json",
  "title": "RetailCompetitiveIntelligencePriceObservation",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "location": {
            "type": "object",
            "properties": { "kind": { "const": "store" } }
          }
        }
      },
      "then": { "properties": { "distribution_store_id": { "type": "string", "minLength": 1 } } },
      "else": { "properties": { "distribution_store_id": { "type": "null" } } }
    }
  ],
  "required": [
    "schema_version",
    "observation_id",
    "analysis_id",
    "product_pack_id",
    "product_pack_version",
    "retailer_id",
    "retailer_name",
    "retailer_product_id",
    "product_name",
    "brand",
    "brand_type",
    "brand_origin",
    "brand_status",
    "image_url",
    "product_url",
    "identity_authority",
    "location",
    "price",
    "regular_price",
    "discounted_price",
    "currency",
    "search_observed",
    "is_sponsored",
    "distribution_store_id",
    "distribution_contract",
    "price_metrics",
    "observed_at",
    "source_authority",
    "location_authority",
    "eligible",
    "exclusion_reasons"
  ],
  "properties": {
    "schema_version": { "const": "1.3.0" },
    "observation_id": { "type": "string", "minLength": 1 },
    "analysis_id": { "type": "string", "minLength": 1 },
    "product_pack_id": { "type": "string", "minLength": 1 },
    "product_pack_version": { "type": "string", "minLength": 1 },
    "retailer_id": { "type": "string", "minLength": 1 },
    "retailer_name": { "type": "string", "minLength": 1 },
    "retailer_product_id": { "type": "string", "minLength": 1 },
    "product_name": { "type": "string", "minLength": 1 },
    "brand": { "type": ["string", "null"] },
    "brand_type": {
      "enum": ["private_label", "regional", "national", "unclassified"]
    },
    "brand_origin": {
      "enum": ["user", "retailer_pack", "search", "pdp", "unresolved"]
    },
    "brand_status": { "type": "string", "minLength": 1 },
    "image_url": { "type": ["string", "null"] },
    "product_url": { "type": ["string", "null"] },
    "identity_authority": { "enum": ["search", "pdp"] },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_key",
        "kind",
        "store_number",
        "store_name",
        "zipcode",
        "city",
        "state",
        "country",
        "latitude",
        "longitude"
      ],
      "properties": {
        "scope_key": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["store", "service_area"] },
        "store_number": { "type": ["string", "null"] },
        "store_name": { "type": ["string", "null"] },
        "zipcode": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "country": { "type": "string", "minLength": 1 },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
      }
    },
    "price": { "type": "number", "exclusiveMinimum": 0 },
    "regular_price": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "discounted_price": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "search_observed": { "const": true },
    "is_sponsored": { "type": ["boolean", "null"] },
    "distribution_store_id": { "type": ["string", "null"], "minLength": 1 },
    "distribution_contract": { "$ref": "#/$defs/distributionContract" },
    "price_metrics": {
      "type": "object",
      "additionalProperties": { "type": ["number", "null"], "minimum": 0 }
    },
    "observed_at": { "type": ["string", "null"], "format": "date-time" },
    "source_authority": { "const": "search_location_observation" },
    "location_authority": { "const": "retailer_location_master" },
    "eligible": { "const": true },
    "exclusion_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "maxItems": 0
    }
  },
  "$defs": {
    "distributionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "basis", "grain", "deduplication", "price_rule", "inventory_claim", "stock_status_used", "sponsorship_used"],
      "properties": {
        "version": { "const": "1.0.0" },
        "basis": { "const": "positive_price_store_search_result" },
        "grain": { "const": "retailer_product_id_x_store_id" },
        "deduplication": { "const": "distinct_store_id_per_product" },
        "price_rule": { "const": "price_gt_zero" },
        "inventory_claim": { "const": false },
        "stock_status_used": { "const": false },
        "sponsorship_used": { "const": false }
      }
    }
  }
}
