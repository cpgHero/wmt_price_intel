{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/price-monitoring-map.schema.json",
  "title": "RetailCompetitiveIntelligencePriceMonitoringMap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "retailer",
    "product",
    "distribution_contract",
    "filters",
    "source",
    "reference_price",
    "display",
    "points"
  ],
  "properties": {
    "schema_version": { "const": "1.3.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "retailer": { "$ref": "#/$defs/idName" },
    "product": { "$ref": "#/$defs/idName" },
    "distribution_contract": { "$ref": "#/$defs/distributionContract" },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "city", "zipcode", "detail"],
      "properties": {
        "state": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "zipcode": { "type": ["string", "null"] },
        "detail": { "enum": ["summary", "full"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "location_authority", "definition"],
      "properties": {
        "authority": { "const": "Search" },
        "location_authority": { "const": "Retailer location master" },
        "definition": { "type": "string", "minLength": 1 }
      }
    },
    "reference_price": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_locations",
        "search_observed_locations",
        "distribution_store_count",
        "service_area_presence_count",
        "observed_points",
        "observed_missing_coordinates",
        "observed_sampled",
        "below_reference_locations",
        "at_reference_locations",
        "above_reference_locations",
        "not_observed_locations",
        "not_observed_points",
        "not_observed_missing_coordinates",
        "not_observed_sampled"
      ],
      "properties": {
        "observed_locations": {
          "type": "integer",
          "minimum": 0,
          "description": "All positive-price Search locations; store and service-area components are reported separately."
        },
        "search_observed_locations": { "type": "integer", "minimum": 0 },
        "distribution_store_count": { "type": "integer", "minimum": 0 },
        "service_area_presence_count": { "type": "integer", "minimum": 0 },
        "observed_points": { "type": "integer", "minimum": 0 },
        "observed_missing_coordinates": { "type": "integer", "minimum": 0 },
        "observed_sampled": { "type": "boolean" },
        "below_reference_locations": { "type": "integer", "minimum": 0 },
        "at_reference_locations": { "type": "integer", "minimum": 0 },
        "above_reference_locations": { "type": "integer", "minimum": 0 },
        "not_observed_locations": { "type": "integer", "minimum": 0 },
        "not_observed_points": { "type": "integer", "minimum": 0 },
        "not_observed_missing_coordinates": { "type": "integer", "minimum": 0 },
        "not_observed_sampled": { "type": "boolean" }
      }
    },
    "points": {
      "type": "array",
      "items": { "$ref": "#/$defs/mapPoint" }
    }
  },
  "$defs": {
    "distributionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "basis", "grain", "deduplication", "price_rule", "inventory_claim", "stock_status_used", "sponsorship_used"],
      "properties": {
        "version": { "const": "1.0.0" },
        "basis": { "const": "positive_price_store_search_result" },
        "grain": { "const": "retailer_product_id_x_store_id" },
        "deduplication": { "const": "distinct_store_id_per_product" },
        "price_rule": { "const": "price_gt_zero" },
        "inventory_claim": { "const": false },
        "stock_status_used": { "const": false },
        "sponsorship_used": { "const": false }
      }
    },
    "idName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "mapPoint": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "observed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "search_observed": { "const": true },
              "price": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "not_observed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "search_observed": { "const": false },
              "is_sponsored": { "const": null },
              "distribution_store_id": { "const": null },
              "price": { "const": null },
              "difference_from_reference": { "const": null }
            }
          }
        }
      ],
      "required": [
        "scope_key",
        "status",
        "search_observed",
        "is_sponsored",
        "distribution_store_id",
        "kind",
        "store_number",
        "store_name",
        "zipcode",
        "city",
        "state",
        "country",
        "latitude",
        "longitude",
        "price",
        "difference_from_reference"
      ],
      "properties": {
        "scope_key": { "type": "string", "minLength": 1 },
        "status": { "enum": ["observed", "not_observed"] },
        "search_observed": { "type": "boolean" },
        "is_sponsored": { "type": ["boolean", "null"] },
        "distribution_store_id": { "type": ["string", "null"], "minLength": 1 },
        "kind": { "enum": ["store", "service_area"] },
        "store_number": { "type": ["string", "null"] },
        "store_name": { "type": ["string", "null"] },
        "zipcode": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "country": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "price": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "difference_from_reference": { "type": ["number", "null"] }
      }
    }
  }
}
