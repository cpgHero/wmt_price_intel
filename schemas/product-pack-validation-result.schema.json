{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpghero.com/schemas/product-pack-validation-result.schema.json",
  "title": "Retail Competitive Intelligence Product Pack Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "draft_id",
    "draft_revision",
    "draft_checksum",
    "suite",
    "status",
    "gates",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "format": "uuid" },
    "draft_id": { "type": "string", "format": "uuid" },
    "draft_revision": { "type": "integer", "minimum": 1 },
    "draft_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "suite": { "enum": ["quick", "compact", "full", "publication"] },
    "status": { "enum": ["queued", "running", "passed", "failed", "cancelled"] },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "message"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "warning", "not_run"] },
          "message": { "type": "string", "minLength": 1 },
          "details": { "type": "object" }
        }
      }
    },
    "engine_version": { "type": ["string", "null"] },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
