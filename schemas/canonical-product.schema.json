{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/canonical-product.schema.json",
  "title": "Retail Competitive Intelligence Canonical Product",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_product_id",
    "retailer_id",
    "retailer_product_id",
    "identifiers",
    "identity",
    "source_contexts",
    "pdp_snapshot_ids",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "canonical_product_id": {
      "type": "string",
      "minLength": 1
    },
    "retailer_id": {
      "type": "string",
      "minLength": 1
    },
    "retailer_product_id": {
      "type": "string",
      "minLength": 1
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "value", "primary"],
        "properties": {
          "scheme": {
            "enum": [
              "retailer_product_id",
              "product_id",
              "item_id",
              "asin",
              "upc",
              "gtin",
              "gtin13",
              "model",
              "sku",
              "other"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "primary": {
            "type": "boolean"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "specification"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "type": ["string", "null"]
        },
        "seller": {
          "type": ["string", "null"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "image_primary": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "description_short": {
          "type": ["string", "null"]
        },
        "description_full": {
          "type": ["string", "null"]
        },
        "category_path": {
          "type": ["string", "null"]
        },
        "model_number": {
          "type": ["string", "null"]
        },
        "item_condition": {
          "type": ["string", "null"]
        },
        "specification": {
          "type": "object"
        },
        "physical_properties": {
          "type": "object"
        },
        "variant_configuration": {
          "type": "object"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_pack_id", "product_pack_version", "in_scope", "attributes"],
      "properties": {
        "product_pack_id": {
          "type": "string",
          "minLength": 1
        },
        "product_pack_version": {
          "type": "string",
          "minLength": 1
        },
        "in_scope": {
          "type": "boolean"
        },
        "attributes": {
          "type": "object"
        },
        "review_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "observed_at"],
        "properties": {
          "source": {
            "enum": ["serp", "pdp", "historical_import", "manual_validation"]
          },
          "zipcode": {
            "type": ["string", "null"]
          },
          "store_number": {
            "type": ["string", "null"]
          },
          "fulfillment_type": {
            "type": ["string", "null"]
          },
          "source_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "pdp_snapshot_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_checksum_sha256", "created_at", "updated_at"],
      "properties": {
        "identity_checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
