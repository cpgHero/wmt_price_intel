{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/product-detail-catalog.schema.json",
  "title": "MetricsCart Product Detail Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "source", "status", "endpoints"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "provider": {
      "const": "metricscart"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "configuration_only_response_fixtures_required",
        "enabled_v1_with_fixtures",
        "catalogued_with_provider_samples"
      ]
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": [
          "retailer_id",
          "provider_retailer",
          "domain",
          "endpoint_id",
          "contract_version",
          "method",
          "path",
          "credits_per_successful_page",
          "paid_calls_enabled",
          "required_params",
            "supported_params"
          ],
        "properties": {
          "retailer_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "provider_retailer": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "endpoint_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "contract_version": {
            "type": "string",
            "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+|[0-9]{4}-[0-9]{2}-[0-9]{2}(?:\\.[0-9]+)?)$"
          },
          "method": {
            "const": "GET"
          },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$"
          },
          "credits_per_successful_page": {
            "type": "integer",
            "minimum": 1
          },
          "paid_calls_enabled": {
            "type": "boolean"
          },
          "required_params": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "url",
                "product_id",
                "zipcode",
                "store",
                "fulfillment_type",
                "shopping_type"
              ]
            }
          },
          "supported_params": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "url",
                "product_id",
                "zipcode",
                "store",
                "fulfillment_type",
                "shopping_type"
              ]
            }
          },
          "default_params": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "minLength": 1 },
              "product_id": { "type": "string", "minLength": 1 },
              "zipcode": { "type": "string", "minLength": 1 },
              "store": { "type": "string", "minLength": 1 },
              "fulfillment_type": { "type": "string", "minLength": 1 },
              "shopping_type": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
