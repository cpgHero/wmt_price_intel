{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/product-detail-catalog.schema.json",
  "title": "MetricsCart Product Detail Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "source", "status", "endpoints"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "provider": {
      "const": "metricscart"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "configuration_only_response_fixtures_required"
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "retailer_id",
          "provider_retailer",
          "domain",
          "endpoint_id",
          "method",
          "path",
          "credits_per_successful_page",
          "required_params",
          "supported_params"
        ],
        "properties": {
          "retailer_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "provider_retailer": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "endpoint_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "method": {
            "const": "GET"
          },
          "path": {
            "type": "string",
            "pattern": "^/mc/"
          },
          "credits_per_successful_page": {
            "type": "integer",
            "minimum": 1
          },
          "required_params": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["url", "product_id", "zipcode", "store", "fulfillment_type"]
            }
          },
          "supported_params": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["url", "product_id", "zipcode", "store", "fulfillment_type"]
            }
          }
        }
      }
    }
  }
}
