{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.local/rci/analysis-evidence.schema.json",
  "title": "Retail Competitive Intelligence Analysis Evidence Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_set_id",
    "analysis_id",
    "kind",
    "row_count",
    "storage",
    "columns",
    "lineage",
    "access",
    "immutable"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_set_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "normalized_offers",
        "classified_offers",
        "product_catalog",
        "exact_matches",
        "compatible_matches",
        "normalized_matches",
        "proximity_matches",
        "segment_metrics",
        "exclusions",
        "validation_issues"
      ]
    },
    "retailer_id": {
      "type": "string",
      "minLength": 1
    },
    "competitor_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "content_type", "checksum_sha256", "byte_size"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "enum": [
            "application/vnd.apache.parquet",
            "application/json",
            "application/gzip",
            "text/csv"
          ]
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "partitioning": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "data_type", "semantic_role", "nullable"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "type": "string",
            "minLength": 1
          },
          "semantic_role": {
            "enum": [
              "identifier",
              "dimension",
              "measure",
              "source_reference",
              "quality_flag",
              "descriptive"
            ]
          },
          "nullable": {
            "type": "boolean"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_set_id",
        "source_artifact_ids",
        "product_pack",
        "analytics_code_version",
        "generated_at"
      ],
      "properties": {
        "input_set_id": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "product_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "checksum_sha256"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "checksum_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "analytics_code_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitivity", "direct_download", "max_preview_rows"],
      "properties": {
        "sensitivity": {
          "enum": ["internal", "confidential"]
        },
        "direct_download": {
          "type": "boolean"
        },
        "max_preview_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "immutable": {
      "const": true
    }
  }
}
